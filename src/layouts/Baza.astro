---
import '@fontsource-variable/space-grotesk';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import podsumowanie from '../../public/dane/podsumowanie.json';

const { tytul, opis, strona } = Astro.props;

// Data pobrania danych ze źródeł — nie mylić z datą przebudowania strony.
// Bierzemy najstarszy znacznik, żeby nie zawyżać aktualności zbioru.
const dataDanych = podsumowanie.danePobrane ? new Date(podsumowanie.danePobrane) : null;
const dataDanychTekst = dataDanych?.toLocaleDateString('pl-PL', {
  day: 'numeric', month: 'long', year: 'numeric',
});
const dataDanychISO = dataDanych?.toISOString().slice(0, 10);
const pelnyTytul = tytul ? `${tytul} — Poznań w danych` : 'Poznań w danych';

const menu = [
  { href: '/', etykieta: 'Pulpit', klucz: 'pulpit' },
  { href: '/umowy/', etykieta: 'Rejestr umów', klucz: 'umowy' },
  { href: '/budzet/', etykieta: 'Budżet', klucz: 'budzet' },
  { href: '/statystyki/', etykieta: 'Statystyki', klucz: 'statystyki' },
  { href: '/porownaj/', etykieta: 'Porównaj miasta', klucz: 'porownaj' },
  { href: '/zrodla/', etykieta: 'Źródła', klucz: 'zrodla' },
];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pelnyTytul}</title>
    <meta name="description" content={opis ?? 'Przeglądarka danych publicznych o Poznaniu: rejestr umów, budżet miasta, statystyki i porównania z innymi miastami.'} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={pelnyTytul} />
    <meta property="og:description" content={opis ?? 'Przeglądarka danych publicznych o Poznaniu: rejestr umów, budżet miasta, statystyki i porównania z innymi miastami.'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="Poznań w danych" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Poznań w danych — rejestr umów, budżet i statystyki miasta" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="szczyt">
      <div class="otoczka szczyt-rzad">
        <a class="logo" href="/">
          <svg class="znak" viewBox="0 0 32 32" width="24" height="24" aria-hidden="true">
            <path class="koziol-l" d="M6.5 8.5 L14.3 16 L6.5 23.5" />
            <path class="koziol-p" d="M25.5 8.5 L17.7 16 L25.5 23.5" />
          </svg>
          Poznań w danych</a>
        <nav class="nawigacja" aria-label="Główna">
          {menu.map((m) => (
            <a href={m.href} aria-current={strona === m.klucz ? 'page' : undefined}>{m.etykieta}</a>
          ))}
        </nav>
      </div>
    </header>

    <main class="otoczka">
      <slot />
    </main>

    <footer class="stopka">
      <div class="otoczka siatka k3">
        <div>
          <h4>O serwisie</h4>
          <p>
            Niezależna przeglądarka danych publicznych o Poznaniu. Wszystkie liczby pochodzą
            z oficjalnych rejestrów i są podlinkowane do źródła — każdą można sprawdzić.
          </p>
          {dataDanych && (
            <p class="drobne" style="margin-bottom:0">
              Dane pobrane ze źródeł <time datetime={dataDanychISO}>{dataDanychTekst}</time>.
              {' '}<a href="/zrodla/">Daty dla każdego źródła osobno</a>.
            </p>
          )}
        </div>
        <div>
          <h4>Źródła danych</h4>
          <ul>
            <li><a href="https://bip.poznan.pl/bip/rejestr-umow/" rel="noopener">Rejestr umów Miasta Poznania (BIP)</a></li>
            <li><a href="https://rejestrumow.gov.pl/" rel="noopener">Centralny Rejestr Umów JSFP</a></li>
            <li><a href="https://badam.poznan.pl/" rel="noopener">badam.poznan.pl</a></li>
            <li><a href="https://www.poznan.pl/opendata" rel="noopener">Poznań — Otwarte Dane</a></li>
            <li><a href="https://bdl.stat.gov.pl/" rel="noopener">GUS Bank Danych Lokalnych</a></li>
            <li><a href="https://dane.gov.pl/" rel="noopener">dane.gov.pl</a></li>
          </ul>
        </div>
        <div>
          <h4>Zastrzeżenia</h4>
          <p>
            Serwis nie jest powiązany z Urzędem Miasta Poznania. Dane przetwarzane są automatycznie;
            w razie rozbieżności rozstrzygające jest źródło pierwotne.
            <a href="/zrodla/">Metodologia i zakres danych</a>.
          </p>
        </div>
      </div>

      <div class="otoczka podpis">
        <p>
          Strona stworzona przez <a href="mailto:przemyslaw@plewinski.pl">przemyslaw@plewinski.pl</a>
          {' '}przy udziale <a href="https://claude.com/claude-code" rel="noopener">Claude Code</a>.
        </p>
        <p>
          Kod źródłowy i skrypty pobierania danych:
          {' '}<a href="https://github.com/PrzemoPle/poznan-dane" rel="noopener">GitHub</a>.
        </p>
      </div>
    </footer>

    <script>
      // Count-up dla wartości KPI — odpala się raz, gdy karta wjedzie w viewport.
      // Parsuje polską notację ("6,66 mld zł", "534 239", "−3 mln") i animuje
      // samą liczbę, zachowując jednostkę. Gaszone przy prefers-reduced-motion.
      const bezRuchu = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!bezRuchu) {
        const wzor = /^([−-]?)([\d\s ]+(?:,\d+)?)/;
        const cele = document.querySelectorAll('.kpi .wartosc, .hero-liczba');
        const obserwator = new IntersectionObserver((wpisy) => {
          for (const w of wpisy) {
            if (!w.isIntersecting) continue;
            obserwator.unobserve(w.target);
            const el = w.target;
            const tekst = el.textContent.trim();
            // Zakresy ("2014–2026") to nie liczby do nabijania — animacja robiła z nich bełkot.
            if (/\d\s*[–—-]\s*\d/.test(tekst)) continue;
            const m = tekst.match(wzor);
            if (!m) continue;
            const znak = m[1];
            // końcowe spacje zostają w "reszcie", żeby nie skleić liczby z jednostką
            const cyfry = m[2].replace(/\s+$/, '');
            const cel = parseFloat(cyfry.replace(/[\s ]/g, '').replace(',', '.'));
            // Małe liczby animują się w mgnieniu oka i tylko migoczą — zostawiamy je w spokoju.
            if (!Number.isFinite(cel) || Math.abs(cel) < 10) continue;
            const miejsca = (cyfry.match(/,(\d+)/) || ['', ''])[1].length;
            const reszta = tekst.slice(znak.length + cyfry.length);
            const start = performance.now();
            const czas = 850;
            const krok = (t) => {
              const p = Math.min(1, (t - start) / czas);
              const zjazd = 1 - Math.pow(1 - p, 3); // easeOutCubic
              const v = cel * zjazd;
              el.textContent = znak + v.toLocaleString('pl-PL', {
                minimumFractionDigits: miejsca, maximumFractionDigits: miejsca,
              }) + reszta;
              if (p < 1) requestAnimationFrame(krok);
            };
            requestAnimationFrame(krok);
          }
        }, { threshold: 0.4 });
        for (const el of cele) obserwator.observe(el);
      }
    </script>
  </body>
</html>
