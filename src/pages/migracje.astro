    s.setAttribute('viewBox', `0 0 ${W} ${H}`); s.setAttribute('height', H);
    const { a, dir } = ageSum(S.area), mid = W / 2, lw = W < 520 ? 44 : 58, mx = Math.max(...a.flat());
