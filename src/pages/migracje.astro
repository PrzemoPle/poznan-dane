    const grow = Object.keys(D.pp).map((c) => [F[c].n, D.pp[c].p25 / D.pp[c].p20 - 1]).sort((a, b) => b[1] - a[1]);
    $('#mg-miesz-fakty').innerHTML = `<div class="mg-fakt"><b>r = ${nf(r, 2)}</b><span>Siła związku między liczbą nowych mieszkań a przeprowadzkami z Poznania (1 to pełna zgodność). To korelacja, nie dowód przyczyny.</span></div>
      <div class="mg-fakt"><b>${pct(grow[0][1])}</b><span>Tyle w latach 2020–2025 przybyło mieszkańców w gminie ${esc(grow[0][0])}. Dalej: ${esc(grow[1][0])} (${pct(grow[1][1])}) i ${esc(grow[2][0])} (${pct(grow[2][1])}).</span></div>
      <p class="drobne" style="margin:0">Kliknij kółko, żeby zobaczyć gminę na mapie.</p>`;
  }

  /* ---------- rok po roku ---------- */
  function lines() {
    const s = $('#mg-linie'), W = s.parentNode.clientWidth - 36 || 600, H = 300;
    s.setAttribute('viewBox', `0 0 ${W} ${H}`); s.setAttribute('height', H);
    const out = Y.map((y) => T('80123')[y]), inn = Y.map((y) => T('80121')[y]);
    const ml = 44, mr = W < 520 ? 78 : 108, mt = 14, mb = 30, iw = W - ml - mr, ih = H - mt - mb;
    const hi = Math.ceil(Math.max(...out) / 1000) * 1000, lo = Math.floor(Math.min(...inn) / 1000) * 1000;
    const xv = (i) => ml + iw * i / (ALL - 1), yv = (v) => mt + ih * (1 - (v - lo) / (hi - lo));
    let h = '';
    for (let t = lo; t <= hi; t += 1000) h += `<line x1="${ml}" x2="${W - mr}" y1="${yv(t)}" y2="${yv(t)}" stroke="var(--linia)"/><text x="${ml - 8}" y="${yv(t) + 4}" text-anchor="end" font-size="10.5" stroke-width="0" class="v">${nf(t)}</text>`;
    Y.forEach((y, i) => { h += `<text x="${xv(i)}" y="${H - 8}" text-anchor="middle" font-size="10.5" stroke-width="0" class="v">${W < 420 && i % 2 ? '' : y}</text>`; });
    const pts = (a) => a.map((v, i) => `${xv(i)},${yv(v)}`).join(' ');
    h += `<polygon points="${pts(out)} ${pts(inn).split(' ').reverse().join(' ')}" fill="var(--mg-out)" opacity=".12"/>`;
    h += '<line id="mg-linie-kreska" y1="' + mt + '" y2="' + (mt + ih) + '" stroke="var(--tekst-3)" stroke-dasharray="3 3" visibility="hidden"/>';
    if (S.yi < ALL) h += `<line x1="${xv(S.yi)}" x2="${xv(S.yi)}" y1="${mt}" y2="${mt + ih}" stroke="var(--atrament)" stroke-dasharray="3 3"/>`;
    h += `<polyline points="${pts(out)}" fill="none" stroke="var(--mg-out)" stroke-width="2" stroke-linejoin="round"/><polyline points="${pts(inn)}" fill="none" stroke="var(--mg-in)" stroke-width="2" stroke-linejoin="round"/>`;
    out.forEach((v, i) => { h += `<circle cx="${xv(i)}" cy="${yv(v)}" r="${S.yi === i ? 6 : 4}" fill="var(--mg-out)" stroke="var(--mg-lad)" stroke-width="2"/>`; });
    inn.forEach((v, i) => { h += `<circle cx="${xv(i)}" cy="${yv(v)}" r="${S.yi === i ? 6 : 4}" fill="var(--mg-in)" stroke="var(--mg-lad)" stroke-width="2"/>`; });
    const lx = xv(ALL - 1) + 10;
    h += `<text x="${lx}" y="${yv(out[ALL - 1]) - 2}" font-size="11" font-weight="600" stroke-width="3">${nf(out[ALL - 1])}</text><text x="${lx}" y="${yv(out[ALL - 1]) + 12}" font-size="10.5" stroke-width="3" class="v">${W < 520 ? 'wymeld.' : 'wymeldowania'}</text><text x="${lx}" y="${yv(inn[ALL - 1]) + 6}" font-size="11" font-weight="600" stroke-width="3">${nf(inn[ALL - 1])}</text><text x="${lx}" y="${yv(inn[ALL - 1]) + 20}" font-size="10.5" stroke-width="3" class="v">${W < 520 ? 'zameld.' : 'zameldowania'}</text>`;
    // niewidoczne pasy lat: cel najechania i kliknięcia jest dużo większy niż kropka
    const pas = iw / (ALL - 1);
    Y.forEach((y, i) => { h += `<rect data-i="${i}" x="${xv(i) - pas / 2}" y="${mt}" width="${pas}" height="${ih}" fill="transparent" style="cursor:pointer"/>`; });
    s.innerHTML = h;
    const tp = $('#mg-tip6'), host = $('#mg-linie-ramka'), kreska = $('#mg-linie-kreska');
    s.onpointermove = (e) => {
      const g = e.target.closest('[data-i]'); if (!g) { tp.style.display = 'none'; kreska.setAttribute('visibility', 'hidden'); return; }
      const i = +g.dataset.i;
      kreska.setAttribute('x1', xv(i)); kreska.setAttribute('x2', xv(i)); kreska.setAttribute('visibility', 'visible');
      tp.innerHTML = `<b>${Y[i]}</b><br>wymeldowania: <b class="mg-o">${nf(out[i])}</b><br>zameldowania: <b class="mg-i">${nf(inn[i])}</b><br>saldo: <b>${sg(inn[i] - out[i])}</b><br>kliknij, żeby wybrać ten rok`;
      placeTip(tp, host, e);
    };
    s.onpointerleave = () => { tp.style.display = 'none'; kreska.setAttribute('visibility', 'hidden'); };
    s.onclick = (e) => { const g = e.target.closest('[data-i]'); if (!g) return; stopPlay(); S.yi = S.yi === +g.dataset.i ? ALL : +g.dataset.i; render(); };

    const j = S.yi < ALL ? S.yi : ALL - 1;
    const sal = Y.map((y, i) => inn[i] - out[i]), jy = Y[j], prev = j ? sal[j - 1] : T('80121')[Y[0] - 1] - T('80123')[Y[0] - 1];
    $('#mg-lata-fakty').innerHTML = `<div class="mg-fakt"><b>${nf(sal[j])}</b><span>saldo migracji wewnętrznych w ${jy} r. (rok wcześniej ${nf(prev)}).</span></div>
      <div class="mg-fakt"><b class="mg-o">${nf(out[j])}</b><span>wymeldowań w ${jy} r., ${pct(out[j] / (j ? out[j - 1] : T('80123')[Y[0] - 1]) - 1)} rok do roku.</span></div>
      <div class="mg-fakt"><b class="mg-i">${nf(inn[j])}</b><span>zameldowań w ${jy} r., ${pct(inn[j] / (j ? inn[j - 1] : T('80121')[Y[0] - 1]) - 1)} rok do roku.</span></div>
      <p class="drobne" style="margin:0">${S.yi === ALL ? 'Wybierz rok na pasku u góry albo kliknij go na wykresie, żeby porównać z poprzednim.' : 'Liczby dla roku wybranego na pasku u góry.'}</p>`;

    const pp = Object.keys(F).filter((c) => c.startsWith(POWIAT)).map((c) => ({ c, v: F[c].v.map((x) => x[0]) }))
      .sort((a, b) => b.v.reduce((x, y) => x + y) - a.v.reduce((x, y) => x + y));
    const cur = S.yi < ALL ? S.yi : -1, yy = S.yi < ALL && S.yi > 0 ? S.yi : ALL - 1;
    $('#mg-male').innerHTML = pp.map((r) => {
      const mx = Math.max(...r.v), ch = r.v[yy] / r.v[yy - 1] - 1;
      return `<button type="button" class="mg-maly" data-c="${r.c}" aria-pressed="${r.c === S.sel}"><h3><span>${esc(F[r.c].n)}</span><em>${nf(r.v.reduce((a, b) => a + b))}</em></h3><div class="mg-maly-s">${r.v.map((v, k) => `<i class="${k === cur || (cur < 0 && k === ALL - 1) ? 'cur' : ''}" style="height:${v / mx * 100}%" title="${Y[k]}: ${nf(v)}"></i>`).join('')}</div><small>${Y[yy]}: ${nf(r.v[yy])}, ${pct(ch)}</small></button>`;
    }).join('');
    $('#mg-male').onclick = (e) => { const b = e.target.closest('.mg-maly'); if (b) { selectG(b.dataset.c); doMapy(); } };
    $('#mg-male-uwaga').textContent = `Liczby przy nazwach to suma ${ZAKRES}. Wyróżniony słupek: ${S.yi < ALL ? Y[S.yi] : Y[ALL - 1]}; pod wykresem zmiana wobec roku poprzedniego. Kliknij gminę, żeby pokazać ją na mapie.`;
    const ppT = Y.map((_, k) => pp.reduce((a, r) => a + r.v[k], 0));
    $('#mg-lata-tytul').textContent = out[ALL - 1] < out[ALL - 2] && ppT[ALL - 1] < ppT[ALL - 2] ? 'Rok po roku: odpływ słabnie' : 'Rok po roku';
  }

  /* ---------- kraj ---------- */
  function country() {
    const ys = yrs();
    let pp = 0, rw = 0, ow = 0;
    for (const c in F) { const n = gsum(c, ys).n; if (c.startsWith(POWIAT)) pp += n; else rw += n; }
    const rows = Object.values(D.woj).map((o) => { let a = 0, b = 0; for (const k of ys) { a += o.v[k][0]; b += o.v[k][1]; } return { n: o.n, o: a, i: b }; }).sort((x, y) => (y.i - y.o) - (x.i - x.o));
    rows.forEach((r) => { ow += r.i - r.o; });
    const tot = ys.reduce((a, k) => a + T('80125')[Y[k]], 0);
    const mx = Math.max(...rows.map((r) => Math.max(r.o, r.i)));
    $('#mg-motyl').innerHTML = `<span class="h" style="text-align:right">z Poznania</span><span></span><span class="h">do Poznania</span><span class="h" style="text-align:right">bilans</span>${rows.map((r) => `<span class="l"><small>${nf(r.o)}</small><i style="width:${r.o / mx * 100}%"></i></span><span class="c">${r.n}</span><span class="r"><i style="width:${r.i / mx * 100}%"></i><small>${nf(r.i)}</small></span><span class="s">${sg(r.i - r.o)}</span>`).join('')}`;
    const pos = Object.keys(F).filter((c) => !c.startsWith(POWIAT)).map((c) => [c, gsum(c, ys).n]).sort((a, b) => b[1] - a[1]).slice(0, 4);
    const neg = rows.filter((r) => Math.round(r.i - r.o) < 0).map((r) => r.n);
    $('#mg-kraj-tytul').textContent = pp < 0 && rw > 0 && ow > 0 ? 'Poznań traci na rzecz powiatu, zyskuje z reszty kraju' : 'Powiat, Wielkopolska, reszta kraju';
    $('#mg-kraj-pod').textContent = `Bilans migracji wewnętrznych Poznania ${yLab()}: ${nf(tot)}. ${neg.length ? `Z innych województw na minus ${neg.length === 1 ? 'wychodzi tylko' : 'wychodzą'} ${neg.join(', ')}.` : 'Ze wszystkimi innymi województwami Poznań jest na plus.'}`;
    $('#mg-kraj-fakty').innerHTML = `<div class="mg-fakt"><b>${sg(Math.round(pp))}</b><span>bilans z 17 gminami powiatu poznańskiego</span></div>
      <div class="mg-fakt"><b>${sg(Math.round(rw))}</b><span>bilans z resztą Wielkopolski; najwięcej na plus: ${pos.map((p) => `${esc(F[p[0]].n)} (${sg(p[1])})`).join(', ')}</span></div>
      <div class="mg-fakt"><b>${sg(Math.round(ow))}</b><span>bilans z innymi województwami</span></div>
      <p class="drobne" style="margin:0">Części są sumą kierunków z macierzy GUS; ukryte komórki dodano szacunkowo, więc mogą różnić się od salda o kilka osób.</p>`;
  }

  /* ---------- tabela wszystkich kierunków ---------- */
  function tabela() {
    const ys = yrs(), q = bezOgonkow($('#mg-tab-fraza').value.trim());
    let rows = Object.keys(F).map((c) => { const s = gsum(c, ys); return { c, n: F[c].n, p: F[c].p, o: s.o, i: s.i, b: s.n, ho: s.ho, hi: s.hi }; });
    const wszystkich = rows.length;
    if (q) rows = rows.filter((r) => bezOgonkow(`${r.n} ${r.p}`).includes(q));
    const tekstowa = S.sort === 'n' || S.sort === 'p', znak = S.kier === 'asc' ? 1 : -1;
    rows.sort((a, b) => znak * (tekstowa ? a[S.sort].localeCompare(b[S.sort], 'pl') : a[S.sort] - b[S.sort]) || a.n.localeCompare(b.n, 'pl'));
    $('#mg-tbody').innerHTML = rows.map((r) => `<tr data-c="${r.c}" tabindex="0" aria-selected="${r.c === S.sel}"><td>${esc(r.n)}</td><td class="mg-waskie"><small>${esc(r.p.replace('powiat ', ''))}</small></td><td class="num">${approx(r.ho, r.o)}${nf(r.o)}</td><td class="num">${approx(r.hi, r.i)}${nf(r.i)}</td><td class="num">${sg(r.b)}</td></tr>`).join('')
      || '<tr><td colspan="5" class="ladowanie">Brak gminy o takiej nazwie.</td></tr>';
    for (const th of document.querySelectorAll('#mg-tabela th[data-sort]')) { if (th.dataset.sort === S.sort) th.dataset.kier = S.kier; else delete th.dataset.kier; }
    $('#mg-tab-pod').textContent = `${wszystkich} gmin województwa wielkopolskiego, z którymi Poznań wymieniał mieszkańców ${yLab()}. Kliknij nagłówek kolumny, żeby ułożyć tabelę, albo wiersz, żeby pokazać gminę na mapie.`;
    $('#mg-tab-licznik').textContent = q ? `Pokazano ${rows.length} z ${wszystkich} gmin.` : 'Znak ≈ oznacza wartość szacunkową (GUS ukrywa komórki z 1–2 osobami).';
  }
  $('#mg-tabela thead').addEventListener('click', (e) => {
    const th = e.target.closest('th[data-sort]'); if (!th) return;
    if (S.sort === th.dataset.sort) S.kier = S.kier === 'asc' ? 'desc' : 'asc';
    else { S.sort = th.dataset.sort; S.kier = (S.sort === 'n' || S.sort === 'p') ? 'asc' : 'desc'; }
    tabela();
  });
  const wybierzZTabeli = (e) => { const tr = e.target.closest('tr[data-c]'); if (tr) { selectG(tr.dataset.c); doMapy(); } };
  $('#mg-tbody').addEventListener('click', wybierzZTabeli);
  $('#mg-tbody').addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); wybierzZTabeli(e); } });
  let tabTimer;
  $('#mg-tab-fraza').addEventListener('input', () => { clearTimeout(tabTimer); tabTimer = setTimeout(tabela, 120); });

  /* ---------- CSV ---------- */
  $('#mg-csv').onclick = () => {
    const wiersze = [`teryt;gmina;powiat;${Y.flatMap((y) => [`z_Poznania_${y}`, `do_Poznania_${y}`]).join(';')}`];
    for (const c of Object.keys(F).sort()) wiersze.push([c, F[c].n, F[c].p, ...F[c].v.flatMap((v) => [v[0], v[1]].map((x) => String(x).replace('.', ',')))].join(';'));
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([`﻿${wiersze.join('\n')}`], { type: 'text/csv;charset=utf-8' }));
    a.download = `migracje-poznan-${Y[0]}-${Y[ALL - 1]}.csv`;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 2000);
  };

  /* ---------- całość ---------- */
  function render() { controls(); drawMap(); panel(); pyramid(); cityMap(); sankey(); scatter(); lines(); country(); tabela(); doAdresu(); }
  // pasek lat przykleja się pod nagłówkiem serwisu, którego wysokość zależy od szerokości okna
  const ustawGore = () => document.documentElement.style.setProperty('--mg-gora', `${document.querySelector('.szczyt')?.offsetHeight ?? 64}px`);
  ustawGore();
  addEventListener('resize', ustawGore);
  zAdresu();
  render();
  requestAnimationFrame(() => requestAnimationFrame(() => { svg.classList.add('mg-plynnie'); csvg.classList.add('mg-plynnie'); }));
  let szer = 0;
  const ro = new ResizeObserver(() => {
    // przerysowujemy tylko przy zmianie szerokości; zmiana wysokości (np. rozwinięta karta) nie zmienia wykresów
    if (box.clientWidth === szer) return;
    szer = box.clientWidth;
    sizeCanvas(); drawMap(); pyramid(); cityMap(); sankey(); scatter(); lines();
  });
  ro.observe(box);
  const mo = new MutationObserver(() => setParticles());
  mo.observe(document.documentElement, { attributes: true, attributeFilter: ['data-motyw'] });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => setParticles());
  if (location.hash.length > 1) { try { document.querySelector(location.hash)?.scrollIntoView(); } catch { /* kotwica spoza strony */ } }
</script>
