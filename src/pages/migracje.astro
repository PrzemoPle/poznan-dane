    $('#mg-wiek-pod').textContent = `Wiek osób, które ${yLab()} wymeldowały się ${where} do innej gminy oraz zameldowały w ${S.area === 'Poznań' ? 'Poznaniu' : 'tej dzielnicy'} spoza miasta. Najedź na wiersz, żeby zobaczyć liczby.`;
    const vo = dir[4] + dir[5] + dir[6] + dir[7];
    const czesci = [[dir[5], 'var(--mg-out)', 'na wieś w Wielkopolsce'], [dir[4], 'var(--mg-s5)', 'do miast w Wielkopolsce'], [dir[6] + dir[7], 'var(--mg-s3)', 'do innych województw']];
    $('#mg-wiek-fakty').innerHTML = `<div class="mg-fakt"><b>${Math.round(kid / to * 100)}%</b><span>wyprowadzających się to dzieci do 14 lat (${nf(kid)} dzieci). Wśród przyjeżdżających: ${Math.round(kidIn / ti * 100)}%.</span></div>
      <div class="mg-fakt"><b>${Math.round(par / to * 100)}%</b><span>wyprowadzających się ma 30–44 lata.</span></div>
      <div class="mg-fakt"><b>${Math.round(yng / ti * 100)}%</b><span>przyjeżdżających ma 20–29 lat. W tym wieku przyjechało ${nf(yng)} osób, a wyjechało ${nf(yngO)}.</span></div>
      <div><p class="mg-etykieta">Dokąd wyjeżdżają</p><div class="mg-stos">${czesci.map((x) => `<i style="width:${x[0] / vo * 100}%;background:${x[1]}" title="${x[2]}: ${nf(x[0])}"></i>`).join('')}</div><div class="mg-stos-leg">${czesci.map((x) => `<span style="--c:${x[1]}">${x[2]} ${Math.round(x[0] / vo * 100)}%</span>`).join('')}</div><p class="drobne" style="margin:8px 0 0">„Wieś" w rozumieniu GUS obejmuje też podmiejskie osiedla, np. w gminach Dopiewo czy Komorniki.</p></div>`;
    const tp = $('#mg-tip3'), host = $('#mg-piramida-ramka');
    s.onpointermove = (e) => {
      const g = e.target.closest('[data-r]'); if (!g) { tp.style.display = 'none'; return; }
      const r = +g.dataset.r;
      tp.innerHTML = `<b>${AG.labels[r]} lat</b><br>wyprowadzki: <b class="mg-o">${nf(a[r][1])}</b><br>przeprowadzki: <b class="mg-i">${nf(a[r][0])}</b><br>bilans: <b>${sg(a[r][0] - a[r][1])}</b>`;
