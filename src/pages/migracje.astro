---
import Baza from '../layouts/Baza.astro';
import D from '../../data/migracje/dane.json';

// Liczby w nagłówku liczymy przy budowaniu z tych samych danych, których używają wykresy:
// strona ma treść także bez JavaScriptu, a tekst nie może rozjechać się z mapą.
const Y = D.Y;
const T = (k) => D.tot[k];
const pl = (n, m = 0) => n.toLocaleString('pl-PL', { maximumFractionDigits: m, minimumFractionDigits: m }).replace('-', '−');
const zeZnakiem = (n, m = 0) => `${n > 0 ? '+' : ''}${pl(n, m)}`;
const suma = (k) => Y.reduce((a, y) => a + T(k)[y], 0);
const wymeldowania = suma('80123');
const zameldowania = suma('80121');
let doPowiatu = 0;
for (const [kod, g] of Object.entries(D.flows)) if (kod.startsWith('3021')) for (const v of g.v) doPowiatu += v[0];
const rok = Y.at(-1), rokPoprz = Y.at(-2);
const wym = T('80123')[rok], wymPoprz = T('80123')[rokPoprz];
const zam = T('80121')[rok], zamPoprz = T('80121')[rokPoprz];
const saldo = zam - wym, saldoPoprz = zamPoprz - wymPoprz;
const najlepsze = Y.every((y) => T('80121')[y] - T('80123')[y] <= saldo);
const ileGmin = Object.keys(D.flows).length;
---

<Baza
  strona="migracje"
  tytul="Migracje — gdzie przeprowadzają się poznaniacy"
  opis={`W latach ${Y[0]}–${rok} z Poznania do innych gmin wymeldowało się ${pl(wymeldowania)} osób, a zameldowało ${pl(zameldowania)}. Interaktywna mapa kierunków, wiek, dzielnice i bilans z resztą kraju.`}
>
  <section style="margin-top:44px">
    <p class="nadtytul">Migracje · meldunki na pobyt stały {Y[0]}–{rok}</p>
    <h1>Gdzie przeprowadzają się poznaniacy</h1>
    <p class="lid">
      W latach {Y[0]}–{rok} z Poznania do innych gmin wymeldowało się {pl(wymeldowania)} mieszkańców,
      a zameldowało {pl(zameldowania)} nowych. Około {Math.round((doPowiatu / wymeldowania) * 100)}% wyprowadzek
      kończy się tuż za granicą miasta, w powiecie poznańskim.
    </p>
    <p class="drobne" style="max-width:74ch">
      Dane Głównego Urzędu Statystycznego o zmianach zameldowania. Kto mieszka bez meldunku, nie jest w nich
      ujęty — co z tego wynika, opisujemy w części <a href="#metoda">Źródła i metoda</a>.
    </p>
  </section>

  <section>
    <div class="siatka mg-kpi">
      <div class="karta kpi">
        <span class="etykieta">Wymeldowania {rok}</span>
        <span class="wartosc">{pl(wym)}</span>
        <span class="opis">{zeZnakiem((wym / wymPoprz - 1) * 100, 1)}% wobec {rokPoprz} r.</span>
      </div>
      <div class="karta kpi">
        <span class="etykieta">Zameldowania {rok}</span>
        <span class="wartosc">{pl(zam)}</span>
        <span class="opis">{zeZnakiem((zam / zamPoprz - 1) * 100, 1)}% wobec {rokPoprz} r.</span>
      </div>
      <div class="karta kpi">
        <span class="etykieta">Saldo {rok}</span>
        <span class="wartosc">{pl(saldo)}</span>
        <span class="opis">{najlepsze ? `najmniejsza strata w latach ${Y[0]}–${rok}; ` : ''}rok wcześniej {pl(saldoPoprz)}</span>
      </div>
      <div class="karta kpi">
        <span class="etykieta">Bilans {Y.length} lat</span>
        <span class="wartosc">{pl(zameldowania - wymeldowania)}</span>
        <span class="opis">średnio ok. {pl(Math.round((wymeldowania - zameldowania) / Y.length / 10) * 10)} osób rocznie na minus</span>
      </div>
    </div>
  </section>

  <nav class="mg-pasek" aria-label="Wybór roku">
    <span class="mg-etykieta" id="mg-lata-opis">Rok</span>
    <div class="mg-seg" id="mg-lata" role="group" aria-labelledby="mg-lata-opis"></div>
    <button type="button" class="pigulka mg-graj" id="mg-graj" aria-pressed="false">
      <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M3 1.5v11l9-5.5z" /></svg><span>Odtwórz lata</span>
    </button>
    <button type="button" class="pigulka" id="mg-link">Kopiuj link do tego widoku</button>
    <span class="drobne" id="mg-link-info" role="status"></span>
  </nav>

  <section class="mg-glowna" id="mapa">
    <div class="mg-lewa">
      <div class="karta mg-ster">
        <div><span class="mg-etykieta" id="mg-tryb-opis">Mapa pokazuje</span><div class="mg-seg" id="mg-tryb" role="group" aria-labelledby="mg-tryb-opis"></div></div>
        <div><span class="mg-etykieta" id="mg-skad-opis">Skąd</span><div class="mg-seg" id="mg-skad" role="group" aria-labelledby="mg-skad-opis"></div></div>
        <label class="pole">Znajdź gminę
          <input type="search" id="mg-szukaj" list="mg-gminy" autocomplete="off" placeholder="np. Dopiewo, Swarzędz, Gniezno" />
          <datalist id="mg-gminy"></datalist>
        </label>
      </div>
      <div id="mg-panel" aria-live="polite"></div>
    </div>
    <div class="mg-prawa">
      <div class="mg-mapa" id="mg-mapa-ramka">
        <svg id="mg-mapa" role="img" aria-label="Mapa aglomeracji poznańskiej z łukami przeprowadzek z Poznania do gmin"></svg>
        <canvas id="mg-fx" aria-hidden="true"></canvas>
        <div class="mg-tip" id="mg-tip"></div>
        <button type="button" class="pigulka mg-fxbtn" id="mg-fxbtn" aria-pressed="true">Zatrzymaj ruch</button>
      </div>
      <div id="mg-legenda"></div>
      <p class="drobne" style="margin:6px 0 0" id="mg-mapa-uwaga"></p>
    </div>
  </section>

  <hr class="rozdz" />

  <section id="wiek">
    <h2>Kto wyjeżdża, a kto przyjeżdża</h2>
    <p class="drobne mg-pod" id="mg-wiek-pod"></p>
    <div class="mg-seg" id="mg-obszar" role="group" aria-label="Obszar" style="margin-bottom:14px"></div>
    <div class="mg-dwa">
      <div class="karta mg-fig" id="mg-piramida-ramka"><svg id="mg-piramida" role="img" aria-label="Piramida wieku osób, które wyprowadziły się z Poznania i przeprowadziły do Poznania"></svg><div class="mg-tip" id="mg-tip3"></div></div>
      <div class="mg-fakty" id="mg-wiek-fakty"></div>
    </div>
  </section>

  <hr class="rozdz" />

  <section id="dzielnice">
    <h2 id="mg-dz-tytul">Dzielnice Poznania</h2>
    <p class="drobne mg-pod">GUS podaje migracje dla pięciu dawnych dzielnic, nie dla 42 osiedli. Kliknij dzielnicę, żeby zobaczyć jej łuki na mapie u góry i jej strumienie obok.</p>
    <div class="mg-dwa mg-odwr">
      <div>
        <div class="mg-mapa" style="aspect-ratio:1000/1077" id="mg-miasto-ramka"><svg id="mg-miasto" role="img" aria-label="Mapa dzielnic Poznania z saldem migracji"></svg><div class="mg-tip" id="mg-tip2"></div></div>
        <div id="mg-legenda2"></div>
      </div>
      <div class="karta mg-fig" id="mg-sankey-ramka"><h3 id="mg-sankey-tytul"></h3><svg id="mg-sankey" role="img" aria-label="Diagram przepływów z dzielnic Poznania do gmin"></svg><div class="mg-tip" id="mg-tip5"></div></div>
    </div>
  </section>

  <hr class="rozdz" />

  <section id="mieszkania">
    <h2>Nowe mieszkania a przeprowadzki z Poznania</h2>
    <p class="drobne mg-pod" id="mg-miesz-pod"></p>
    <div class="mg-dwa">
      <div class="karta mg-fig" id="mg-punkty-ramka"><svg id="mg-punkty" role="img" aria-label="Wykres punktowy: nowe mieszkania a przeprowadzki z Poznania w gminach powiatu poznańskiego"></svg><div class="mg-tip" id="mg-tip4"></div></div>
      <div class="mg-fakty" id="mg-miesz-fakty"></div>
    </div>
  </section>

  <hr class="rozdz" />

  <section id="lata">
    <h2 id="mg-lata-tytul">Rok po roku</h2>
    <p class="drobne mg-pod">Wymeldowania z Poznania i zameldowania w Poznaniu w ruchu krajowym. Kliknij rok na wykresie, żeby przełączyć na niego całą stronę.</p>
    <div class="mg-dwa">
      <div class="karta mg-fig" id="mg-linie-ramka"><svg id="mg-linie" role="img" aria-label={`Wykres liniowy wymeldowań i zameldowań ${Y[0]}–${rok}`}></svg><div class="mg-tip" id="mg-tip6"></div></div>
      <div class="mg-fakty" id="mg-lata-fakty"></div>
    </div>
    <h3 style="margin:34px 0 4px">17 gmin powiatu poznańskiego: wyprowadzki z Poznania w kolejnych latach</h3>
    <p class="drobne" id="mg-male-uwaga" style="margin:0"></p>
    <div class="mg-male" id="mg-male"></div>
  </section>

  <hr class="rozdz" />

  <section id="kraj">
    <h2 id="mg-kraj-tytul">Powiat, Wielkopolska, reszta kraju</h2>
    <p class="drobne mg-pod" id="mg-kraj-pod"></p>
    <div class="mg-dwa mg-odwr">
      <div class="mg-fakty" id="mg-kraj-fakty"></div>
      <div class="karta mg-fig">
        <div class="mg-motyl" id="mg-motyl"></div>
        <p class="drobne" style="margin:10px 0 0">Lewa strona: wyprowadzki z Poznania. Prawa: przeprowadzki do Poznania. Ostatnia kolumna: bilans dla Poznania.</p>
      </div>
    </div>
  </section>

  <hr class="rozdz" />

  <section id="tabela">
    <h2>Wszystkie kierunki w Wielkopolsce</h2>
    <p class="drobne mg-pod" id="mg-tab-pod"></p>
    <div class="karta cien" style="padding:16px 18px">
      <div class="mg-tab-ster">
        <label class="pole" style="max-width:360px;flex:1 1 240px">Szukaj gminy albo powiatu
          <input type="search" id="mg-tab-fraza" placeholder="np. Kórnik, powiat gnieźnieński" autocomplete="off" />
        </label>
        <button type="button" class="pigulka" id="mg-csv">Pobierz dane gmin (CSV)</button>
      </div>
      <div class="tabela-otok mg-tab-otok" style="margin-top:12px">
        <table id="mg-tabela">
          <thead>
            <tr>
              <th class="sortowalna" data-sort="n">Gmina</th>
              <th class="sortowalna mg-waskie" data-sort="p">Powiat</th>
              <th class="num sortowalna" data-sort="o">Z Poznania</th>
              <th class="num sortowalna" data-sort="i">Do Poznania</th>
              <th class="num sortowalna" data-sort="b">Bilans</th>
            </tr>
          </thead>
          <tbody id="mg-tbody"></tbody>
        </table>
      </div>
      <p class="drobne" id="mg-tab-licznik" style="margin:10px 0 0" aria-live="polite"></p>
    </div>
  </section>

  <hr class="rozdz" />

  <section id="metoda">
    <h2>Źródła i metoda</h2>
    <div class="siatka k2" style="align-items:start">
      <div>
        <h3>Skąd są dane</h3>
        <ul>
          <li>Kierunki: GUS, Baza Demografia, tabl. 2g — macierz migracji wewnętrznych na pobyt stały między wszystkimi
            gminami w Polsce, {Y[0]}–{rok} (<a href="https://demografia.stat.gov.pl/bazademografia/Tables.aspx" rel="noopener">demografia.stat.gov.pl</a>).
            Poznań jest w niej podzielony na 5 dzielnic.</li>
          <li>Wiek i rodzaj kierunku: GUS, Baza Demografia, tabl. 14 — migracje w Poznaniu według dzielnic, wieku i kierunków.</li>
          <li>Dzielnice: GUS, tablica bilansowa 00PA (stan i ruch ludności według podziału administracyjnego; lata 2020 i 2021
            w wersji po spisie powszechnym 2021).</li>
          <li>Sumy dla miasta i nowe mieszkania: GUS, Bank Danych Lokalnych (<a href="https://bdl.stat.gov.pl" rel="noopener">bdl.stat.gov.pl</a>) —
            zameldowania i wymeldowania w ruchu wewnętrznym, mieszkania oddane do użytkowania na 1000 ludności.</li>
          <li>Granice: gminy i powiaty z Państwowego Rejestru Granic (GUGiK, 2025); osiedla Poznania z OpenStreetMap.
            Dzielnice to suma osiedli przypisanych do dawnych dzielnic.</li>
        </ul>
        <p class="drobne">Dane pobrano w listopadzie 2026 r. Sumy roczne z macierzy porównaliśmy z Bankiem Danych Lokalnych:
          wymeldowania i zameldowania zgadzają się w każdym roku z dokładnością do kilku osób (różnica wynika z komórek ukrytych przez GUS).</p>
      </div>
      <div>
        <h3>Jak czytać liczby</h3>
        <ul>
          <li><strong>Migracja to zmiana zameldowania</strong> na pobyt stały między gminami. Kto mieszka bez meldunku, nie jest
            ujęty — liczby pokazują więc ruch meldunków, a nie wszystkie faktyczne przeprowadzki.</li>
          <li><strong>GUS ukrywa komórki z 1–2 osobami.</strong> Ich łączną liczbę znamy z sum, więc dzielimy ją po równo
            ({pl(Math.min(...Object.values(D.avgOut), ...Object.values(D.avgIn)), 2)}–{pl(Math.max(...Object.values(D.avgOut), ...Object.values(D.avgIn)), 2)} osoby
            na komórkę). Przy małych kierunkach liczby są szacunkiem — oznaczamy je znakiem ≈.</li>
          <li><strong>Bilans z gminą</strong> to przeprowadzki z gminy do Poznania minus wyprowadzki z Poznania do gminy.
            Wynik ujemny oznacza, że Poznań traci.</li>
          <li><strong>Wiek i dzielnice</strong> liczymy bez przeprowadzek wewnątrz Poznania.</li>
          <li><strong>Mieszkania a przeprowadzki</strong> to korelacja, a nie dowód przyczyny.</li>
          <li><strong>Dla pojedynczej dzielnicy</strong> GUS pozwala wskazać gminę docelową tylko w powiecie poznańskim.</li>
        </ul>
      </div>
    </div>
  </section>
</Baza>

<style is:global>
  /* Kolory serii jak w reszcie serwisu: ubytek — złoto, przyrost — błękit. Odcienie skal powstają
     z tych samych tokenów (color-mix), więc same przechodzą między motywem jasnym i ciemnym. */
  :root {
    --mg-out: var(--zloto);
    --mg-in: var(--blekit);
    --mg-lad: var(--papier-2);
    --mg-zero: color-mix(in srgb, var(--tekst-3) 10%, var(--papier-2));
    --mg-miasto: color-mix(in srgb, var(--tekst-2) 42%, var(--papier-2));
    --mg-s1: color-mix(in srgb, var(--tekst-2) 14%, var(--papier-2));
    --mg-s2: color-mix(in srgb, var(--tekst-2) 25%, var(--papier-2));
    --mg-s3: color-mix(in srgb, var(--tekst-2) 37%, var(--papier-2));
    --mg-s4: color-mix(in srgb, var(--tekst-2) 50%, var(--papier-2));
    --mg-s5: color-mix(in srgb, var(--tekst-2) 64%, var(--papier-2));
    --mg-s6: color-mix(in srgb, var(--tekst-2) 80%, var(--papier-2));
    --mg-n1: color-mix(in srgb, var(--zloto) 26%, var(--papier-2));
    --mg-n2: color-mix(in srgb, var(--zloto) 48%, var(--papier-2));
    --mg-n3: color-mix(in srgb, var(--zloto) 74%, var(--papier-2));
    --mg-n4: var(--zloto);
    --mg-p1: color-mix(in srgb, var(--blekit) 26%, var(--papier-2));
    --mg-p2: color-mix(in srgb, var(--blekit) 48%, var(--papier-2));
    --mg-p3: color-mix(in srgb, var(--blekit) 74%, var(--papier-2));
    --mg-p4: var(--blekit);
    --mg-czastka: color-mix(in srgb, var(--zloto) 40%, var(--atrament));
    --mg-gora: 64px;
  }
  html:has(.mg-pasek) { scroll-padding-top: calc(var(--mg-gora) + 64px); }

  .mg-kpi { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
  .mg-kpi .wartosc { white-space: nowrap; }
  .mg-etykieta { display: block; margin-bottom: 5px; font-family: var(--mono); font-size: .68rem; font-weight: 600; color: var(--tekst-3); text-transform: uppercase; letter-spacing: .1em; }
  .mg-seg { display: flex; flex-wrap: wrap; gap: 6px; }
  .mg-seg button:disabled { opacity: .4; cursor: not-allowed; }
  .mg-pod { margin: -8px 0 16px; max-width: 74ch; }

  /* pasek lat: przykleja się pod nagłówkiem serwisu i steruje całą stroną */
  .mg-pasek {
    position: sticky; top: var(--mg-gora); z-index: 40;
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px;
    margin-top: 28px; padding: 9px 0;
    background: color-mix(in srgb, var(--papier) 93%, transparent); backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--linia);
  }
  .mg-pasek .mg-etykieta { margin: 0; }
  .mg-graj svg { width: 11px; height: 11px; fill: currentColor; }

  .mg-glowna { display: grid; grid-template-columns: minmax(300px, .78fr) minmax(0, 1.55fr); gap: 18px clamp(20px, 3vw, 40px); align-items: start; margin-top: 22px; }
  .mg-lewa { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
  .mg-ster { display: flex; flex-direction: column; gap: 14px; padding: 16px 18px; }
  .mg-prawa { position: sticky; top: calc(var(--mg-gora) + 62px); min-width: 0; }
  .mg-mapa { position: relative; width: 100%; aspect-ratio: 1000 / 946; background: var(--mg-lad); border: 1px solid var(--linia); border-radius: var(--r); overflow: hidden; }
  .mg-mapa svg, .mg-mapa canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .mg-mapa canvas { pointer-events: none; }
  .mg-fxbtn { position: absolute; right: 10px; bottom: 10px; z-index: 2; background: color-mix(in srgb, var(--papier-2) 90%, transparent); }

  .mg-gm { stroke: var(--mg-lad); stroke-width: .7; vector-effect: non-scaling-stroke; cursor: pointer; }
  /* przejście koloru włączamy dopiero po pierwszym narysowaniu — inaczej mapa startuje od czerni */
  svg.mg-plynnie .mg-gm, svg.mg-plynnie .mg-cdz { transition: fill .35s; }
  .mg-gm:hover { stroke: var(--atrament); stroke-width: 1.6; }
  .mg-wybor { fill: none; stroke: var(--czerwien); stroke-width: 2.4; vector-effect: non-scaling-stroke; pointer-events: none; }
  .mg-pow { fill: none; stroke: var(--tekst-3); stroke-width: .7; stroke-opacity: .45; vector-effect: non-scaling-stroke; pointer-events: none; }
  .mg-pow.pp { stroke: var(--atrament); stroke-opacity: .75; stroke-width: 1.3; stroke-dasharray: 5 4; }
  .mg-dz { fill: var(--mg-miasto); stroke: var(--mg-lad); stroke-width: 1.2; vector-effect: non-scaling-stroke; cursor: pointer; transition: fill .2s; }
  .mg-dz:hover { fill: color-mix(in srgb, var(--mg-miasto) 70%, var(--atrament)); }
  .mg-dz.on { fill: color-mix(in srgb, var(--mg-out) 60%, var(--mg-miasto)); }
  .mg-lukC { fill: none; stroke: var(--mg-lad); stroke-linecap: round; vector-effect: non-scaling-stroke; opacity: .92; pointer-events: none; }
  .mg-luk { fill: none; stroke: var(--mg-out); stroke-linecap: round; vector-effect: non-scaling-stroke; pointer-events: none; transition: opacity .2s; }
  .mg-luk.do { stroke: var(--mg-in); }
  svg.hl .mg-luk { opacity: .18; } svg.hl .mg-lukC { opacity: .2; } svg.hl .mg-luk.on { opacity: 1; }
  .mg-kropka { fill: var(--mg-out); stroke: var(--mg-lad); stroke-width: 1.5; vector-effect: non-scaling-stroke; pointer-events: none; }
  .mg-zrodlo { fill: var(--atrament); stroke: var(--mg-lad); stroke-width: 2; vector-effect: non-scaling-stroke; pointer-events: none; }
  .mg-mapa svg text, .mg-fig svg text { paint-order: stroke; stroke: var(--mg-lad); stroke-linejoin: round; fill: var(--tekst); font-family: var(--mono); pointer-events: none; }
  .mg-mapa svg text.v, .mg-fig svg text.v { fill: var(--tekst-2); }

  .mg-tip { position: absolute; z-index: 3; pointer-events: none; display: none; min-width: 190px; max-width: 290px; padding: 9px 11px; background: var(--papier-2); border: 1px solid var(--linia-mocna); border-radius: var(--r); box-shadow: var(--cien-hover); font-size: .82rem; line-height: 1.45; color: var(--tekst-2); }
  .mg-tip b { font-weight: 600; color: var(--tekst); }
  .mg-tip .mg-iskry { display: flex; align-items: flex-end; gap: 3px; height: 34px; margin-top: 6px; }
  .mg-tip .mg-iskry i { display: block; width: 12px; background: var(--mg-out); border-radius: 2px 2px 0 0; opacity: .5; }
  .mg-tip .mg-iskry i.cur { opacity: 1; }
  /* liczby zostają w kolorze tekstu; serię wskazuje kwadrat przed nimi */
  .mg-o::before, .mg-i::before { content: ''; display: inline-block; width: .6em; height: .6em; margin-right: .35em; border-radius: 1px; vertical-align: .02em; }
  .mg-o::before { background: var(--mg-out); }
  .mg-i::before { background: var(--mg-in); }

  .mg-leg-tytul { margin-top: 12px; font-size: .8rem; color: var(--tekst-3); }
