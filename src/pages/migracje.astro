      else if (S.mode === 'chg') { const [a, b] = cmpYears(); items.sort((p, q) => q.v - p.v); list = items.slice(0, 5).concat(items.slice(-5).reverse()); title = `Największe zmiany: ${Y[b]} wobec ${Y[a]}`; }
      else { items.sort((a, b) => a.v - b.v); list = items.slice(0, 6).concat(items.slice(-4).reverse().filter((x) => x.v > 0)); title = `Bilans ${yLab()}: najwięcej na minus i na plus`; }
