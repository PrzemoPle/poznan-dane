    if (S.mode === 'chg') { const [a, b] = cmpYears(); return `<b>${esc(f.n)}</b><br>wyprowadzki ${Y[a]}: ${nf(f.v[a][0])}, ${Y[b]}: ${nf(f.v[b][0])}<br>zmiana: <b>${sg(f.v[b][0] - f.v[a][0])}</b>${spark(c, b)}`; }
    return `<b>${esc(f.n)}</b> · ${esc(f.p)}<br>${cap(yLab())}: z Poznania <b class="mg-o">${approx(s.ho, s.o)}${nf(s.o)}</b>, do Poznania <b class="mg-i">${approx(s.hi, s.i)}${nf(s.i)}</b><br>bilans dla Poznania: <b>${sg(s.n)}</b>${spark(c, S.yi === ALL ? -1 : S.yi)}`;
  }
  function placeTip(t, host, e) {
