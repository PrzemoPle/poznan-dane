    };
    s.onpointerleave = () => { tp.style.display = 'none'; };
  }

  /* ---------- dzielnice: mapa + strumienie ---------- */
  function dzStats(z, ys = yrs()) {
    const r = D.dz[DZN[z]]; let eo = 0, ei = 0, pop = 0; const pp = {};
    for (const k of ys) { const x = r[k]; eo += x.eo; ei += x.ei; pop += x.pop; for (const c in x.pp) pp[c] = (pp[c] || 0) + (x.pp[c] < 0 ? D.avgOut[Y[k]] : x.pp[c]); }
    pop /= ys.length;
    return { eo, ei, net: ei - eo, pop, rate: (ei - eo) / pop / ys.length * 1000, pp };
  }
  const C = D.city, csvg = $('#mg-miasto');
  csvg.setAttribute('viewBox', `0 0 ${C.w} ${C.h}`);
  csvg.innerHTML = `<g>${C.dz.map((z, i) => `<path d="${z.d}" data-z="${i}" class="mg-cdz" style="stroke:var(--mg-lad);stroke-width:3;vector-effect:non-scaling-stroke;cursor:pointer"/>`).join('')}</g><g>${C.os.map((o) => `<path d="${o.d}" fill="none" style="stroke:var(--mg-lad);stroke-opacity:.5;stroke-width:.7;vector-effect:non-scaling-stroke;pointer-events:none"/>`).join('')}</g><g id="mg-cSel"></g><g id="mg-cL"></g>`;
  const DT = [0.5, 1.5, 3, 5];
  const dfill = (v) => { let k = -1; DT.forEach((x, i) => { if (Math.abs(v) >= x) k = i; }); return k < 0 ? 'var(--mg-zero)' : (v < 0 ? `var(--mg-n${k + 1})` : `var(--mg-p${k + 1})`); };
  function cityMap() {
    const k = (csvg.clientWidth || 400) / C.w, st = DZN.map((_, z) => dzStats(z));
    csvg.querySelectorAll('.mg-cdz').forEach((p, i) => p.setAttribute('fill', dfill(st[i].rate)));
    $('#mg-cSel').innerHTML = S.dz >= 0 ? `<path d="${C.dz[S.dz].d}" fill="none" style="stroke:var(--czerwien);stroke-width:3;vector-effect:non-scaling-stroke;pointer-events:none"/>` : '';
    $('#mg-cL').innerHTML = C.dz.map((z, i) => `<text x="${z.x}" y="${z.y}" text-anchor="middle" font-size="${13 / k}" stroke-width="${4 / k}" font-weight="600">${z.n}</text><text x="${z.x}" y="${z.y + 16 / k}" text-anchor="middle" font-size="${12 / k}" stroke-width="${4 / k}">${sg(st[i].rate, 1)}‰</text>`).join('');
    const cells = [...DT].reverse().map((x, i) => [`var(--mg-n${DT.length - i})`, `−${nf(x, 1)}`]).concat([['var(--mg-zero)', '0']], DT.map((x, i) => [`var(--mg-p${i + 1})`, `+${nf(x, 1)}`]));
    $('#mg-legenda2').innerHTML = `<div class="mg-leg-tytul">Saldo z resztą kraju na 1000 mieszkańców${S.yi === ALL ? ', średnio rocznie' : ''}</div>${komorki(cells)}<div class="mg-leg-konce"><span>dzielnica traci</span><span>zyskuje</span></div>`;
    const best = st.map((s, i) => [i, s.rate]).sort((a, b) => b[1] - a[1]);
    $('#mg-dz-tytul').textContent = best[0][1] > 0
      ? `Dzielnice: ${DZN[best[0][0]]} zyskuje mieszkańców, ${DZN[best[4][0]]} traci najszybciej`
      : `Dzielnice: każda traci mieszkańców, najszybciej ${DZN[best[4][0]]}`;
  }
  const tip2 = $('#mg-tip2'), cbox = $('#mg-miasto-ramka');
  csvg.addEventListener('pointermove', (e) => {
    const p = e.target.closest('.mg-cdz'); if (!p) { tip2.style.display = 'none'; return; }
    const i = +p.dataset.z, s = dzStats(i);
    tip2.innerHTML = `<b>${DZN[i]}</b> · ok. ${nf(Math.round(s.pop / 1000))} tys. mieszkańców<br>${cap(yLab())}: poza Poznań <b class="mg-o">${nf(s.eo)}</b>, spoza Poznania <b class="mg-i">${nf(s.ei)}</b><br>saldo: <b>${sg(s.net)}</b> (${sg(s.rate, 1)}‰ rocznie)`;
    placeTip(tip2, cbox, e);
  });
  csvg.addEventListener('pointerleave', () => { tip2.style.display = 'none'; });
  csvg.addEventListener('click', (e) => { const p = e.target.closest('.mg-cdz'); if (p) setDz(S.dz === +p.dataset.z ? -1 : +p.dataset.z); });
  function sankey() {
    const s = $('#mg-sankey'), W = s.parentNode.clientWidth - 36 || 600, narrow = W < 560, H = narrow ? 560 : 470;
    s.setAttribute('viewBox', `0 0 ${W} ${H}`); s.setAttribute('height', H);
    const st = DZN.map((_, z) => dzStats(z));
    const tot = {}; st.forEach((x) => { for (const c in x.pp) tot[c] = (tot[c] || 0) + x.pp[c]; });
    const top = Object.entries(tot).sort((a, b) => b[1] - a[1]).slice(0, 7).map((x) => x[0]);
    const R = top.map((c) => ({ id: c, n: short(F[c].n) })).concat([{ id: 'pp', n: 'inne w powiecie' }, { id: 'x', n: 'poza powiatem' }]);
    const flow = (z, id) => {
      const x = st[z];
      if (id === 'pp') return Object.entries(x.pp).filter(([c]) => !top.includes(c)).reduce((a, b) => a + b[1], 0);
      if (id === 'x') return Math.max(0, x.eo - Object.values(x.pp).reduce((a, b) => a + b, 0));
      return x.pp[id] || 0;
    };
    const F2 = DZN.map((_, z) => R.map((r) => flow(z, r.id)));
    const L = DZN.map((n, z) => F2[z].reduce((a, b) => a + b, 0)), Rv = R.map((_, j) => F2.reduce((a, row) => a + row[j], 0));
    const total = L.reduce((a, b) => a + b, 0);
    const fs = narrow ? 10.5 : 11.5, cw = fs * .62, nw = 12, gap = 7, top0 = 22;
    const ml = Math.max(...DZN.map((n) => n.length)) * cw + 14;
    const mr = nw + 12 + (narrow ? Math.max(...R.map((r, j) => Math.max(r.n.length, nf(Rv[j]).length))) : Math.max(...R.map((r, j) => r.n.length + 1 + nf(Rv[j]).length))) * cw;
    const scL = (H - top0 - 8 - gap * 4) / total, scR = (H - top0 - 8 - gap * (R.length - 1)) / total;
    const x0 = ml, x1 = W - mr;
    let yl = top0; const LY = L.map((v) => { const y = yl; yl += v * scL + gap; return y; });
    let yr = top0; const RY = Rv.map((v) => { const y = yr; yr += v * scR + gap; return y; });
    const offL = LY.slice(), offR = RY.slice();
    let h = `<text x="${x0}" y="12" font-size="10.5" stroke-width="0" class="v" text-anchor="middle">dzielnica</text><text x="${x1 + nw}" y="12" font-size="10.5" stroke-width="0" class="v" text-anchor="middle">dokąd</text>`;
    DZN.forEach((n, z) => R.forEach((r, j) => {
      const v = F2[z][j]; if (v <= 0) return;
      const a0 = offL[z], a1 = a0 + v * scL, b0 = offR[j], b1 = b0 + v * scR; offL[z] = a1; offR[j] = b1;
      const xm = (x0 + nw + x1) / 2;
      h += `<path data-z="${z}" data-j="${j}" data-v="${v}" d="M${x0 + nw} ${a0}C${xm} ${a0} ${xm} ${b0} ${x1} ${b0}L${x1} ${b1}C${xm} ${b1} ${xm} ${a1} ${x0 + nw} ${a1}Z" fill="${j < 7 ? 'var(--mg-out)' : 'var(--mg-s5)'}" fill-opacity="${S.dz < 0 ? .5 : S.dz === z ? .75 : .07}" style="cursor:pointer"/>`;
    }));
    DZN.forEach((n, z) => { h += `<rect x="${x0}" y="${LY[z]}" width="${nw}" height="${Math.max(2, L[z] * scL)}" fill="var(--atrament)" data-z="${z}" style="cursor:pointer"/><text x="${x0 - 8}" y="${LY[z] + L[z] * scL / 2}" text-anchor="end" font-size="${fs}" stroke-width="3" font-weight="600" dy="-2">${n}</text><text x="${x0 - 8}" y="${LY[z] + L[z] * scL / 2 + fs}" text-anchor="end" font-size="${fs - 1}" stroke-width="3" class="v" dy="-2">${nf(L[z])}</text>`; });
    R.forEach((r, j) => {
      const y = RY[j] + Rv[j] * scR / 2;
      h += `<rect x="${x1}" y="${RY[j]}" width="${nw}" height="${Math.max(2, Rv[j] * scR)}" fill="${j < 7 ? 'var(--mg-out)' : 'var(--mg-s5)'}"/>${narrow
        ? `<text x="${x1 + nw + 8}" y="${y - 1}" font-size="${fs}" stroke-width="3">${esc(r.n)}</text><text x="${x1 + nw + 8}" y="${y + fs - 1}" font-size="${fs - 1}" stroke-width="3" class="v">${nf(Rv[j])}</text>`
        : `<text x="${x1 + nw + 8}" y="${y + 4}" font-size="${fs}" stroke-width="3">${esc(r.n)} <tspan class="v">${nf(Rv[j])}</tspan></text>`}`;
    });
    s.innerHTML = h;
    $('#mg-sankey-tytul').textContent = `Wymeldowania z dzielnic poza Poznań ${yLab()}: ${nf(total)}`;
    s.onclick = (e) => { const t = e.target.closest('[data-z]'); if (t) setDz(S.dz === +t.dataset.z ? -1 : +t.dataset.z); };
    const tp = $('#mg-tip5'), host = $('#mg-sankey-ramka');
    s.onpointermove = (e) => {
      const t = e.target.closest('path[data-j]'); if (!t) { tp.style.display = 'none'; return; }
      const z = +t.dataset.z, j = +t.dataset.j, v = +t.dataset.v;
      tp.innerHTML = `<b>${DZN[z]} → ${esc(R[j].n)}</b><br>${cap(yLab())}: <b class="mg-o">${nf(v)}</b> osób<br>${nf(v / L[z] * 100, 1)}% wymeldowań z tej dzielnicy`;
      placeTip(tp, host, e);
    };
    s.onpointerleave = () => { tp.style.display = 'none'; };
  }

  /* ---------- mieszkania a przeprowadzki ---------- */
  function scatter() {
    const s = $('#mg-punkty'), W = s.parentNode.clientWidth - 36 || 600, narrow = W < 560, H = narrow ? 360 : 440;
    s.setAttribute('viewBox', `0 0 ${W} ${H}`); s.setAttribute('height', H);
    const ys = yrs();
    const pts = Object.keys(D.pp).map((c) => {
      const p = D.pp[c], pop = (p.p20 + p.p25) / 2;
      const dw = ys.reduce((a, k) => a + p.dw[k], 0) / ys.length;
      return { c, n: F[c].n, x: dw, y: gsum(c, ys).o / ys.length / pop * 1000, pop: p.p25 };
    });
    const ml = 40, mr = 16, mt = 20, mb = 46, iw = W - ml - mr, ih = H - mt - mb;
    const xM = Math.ceil(Math.max(...pts.map((p) => p.x)) / 5) * 5, yM = Math.ceil(Math.max(...pts.map((p) => p.y)) / 5) * 5;
    const xv = (v) => ml + iw * v / xM, yv = (v) => mt + ih * (1 - v / yM), rv = (p) => 4 + 11 * Math.sqrt(p.pop / 60000);
    let h = '';
    for (let t = 0; t <= yM; t += 5) h += `<line x1="${ml}" x2="${W - mr}" y1="${yv(t)}" y2="${yv(t)}" stroke="var(--linia)"/><text x="${ml - 8}" y="${yv(t) + 4}" text-anchor="end" font-size="10.5" stroke-width="0" class="v">${t}</text>`;
    for (let t = 0; t <= xM; t += 5) h += `<text x="${xv(t)}" y="${H - mb + 18}" text-anchor="middle" font-size="10.5" stroke-width="0" class="v">${t}</text>`;
    h += `<text x="${ml + iw / 2}" y="${H - 6}" text-anchor="middle" font-size="10.5" stroke-width="0" class="v">${narrow ? 'nowe mieszkania rocznie na 1000 mieszk.' : 'nowe mieszkania rocznie na 1000 mieszkańców gminy'}</text>`;
    h += `<text x="${ml}" y="${mt - 8}" font-size="10.5" stroke-width="0" class="v">${narrow ? 'z Poznania rocznie na 1000 mieszk.' : 'przeprowadzki z Poznania rocznie na 1000 mieszkańców gminy'}</text>`;
    const n = pts.length, mx = pts.reduce((a, p) => a + p.x, 0) / n, my = pts.reduce((a, p) => a + p.y, 0) / n;
    const sxy = pts.reduce((a, p) => a + (p.x - mx) * (p.y - my), 0), sxx = pts.reduce((a, p) => a + (p.x - mx) ** 2, 0), syy = pts.reduce((a, p) => a + (p.y - my) ** 2, 0);
    const b = sxy / sxx, a0 = my - b * mx, r = sxy / Math.sqrt(sxx * syy);
    h += `<line x1="${xv(0)}" y1="${yv(Math.max(0, a0))}" x2="${xv(xM)}" y2="${yv(Math.min(yM, a0 + b * xM))}" stroke="var(--tekst-3)" stroke-dasharray="5 5"/>`;
    for (const p of [...pts].sort((p, q) => q.pop - p.pop)) h += `<circle cx="${xv(p.x)}" cy="${yv(p.y)}" r="${rv(p)}" fill="var(--mg-out)" fill-opacity="${p.c === S.sel ? 1 : .78}" stroke="${p.c === S.sel ? 'var(--czerwien)' : 'var(--mg-lad)'}" stroke-width="${p.c === S.sel ? 2.5 : 2}" data-c="${p.c}" style="cursor:pointer"/>`;
    const placed = [];
    for (const p of [...pts].sort((p, q) => q.y - p.y)) {
      const t = narrow ? short(p.n) : p.n, w = t.length * 6.9, x = xv(p.x), y = yv(p.y), rr = rv(p);
      const cand = [[x + rr + 4, y + 4, 'start'], [x - rr - 4, y + 4, 'end'], [x, y - rr - 5, 'middle'], [x, y + rr + 14, 'middle']];
      for (const [lx, ly, an] of cand) {
        const xa = an === 'start' ? lx : an === 'end' ? lx - w : lx - w / 2, bb = [xa, ly - 11, xa + w, ly + 3];
        if (bb[0] < 2 || bb[2] > W - 2 || bb[1] < 0 || bb[3] > H - mb) continue;
        if (placed.some((q) => !(bb[2] < q[0] || bb[0] > q[2] || bb[3] < q[1] || bb[1] > q[3]))) continue;
        placed.push(bb); h += `<text x="${lx}" y="${ly}" text-anchor="${an}" font-size="11" stroke-width="3.5">${esc(t)}</text>`; break;
      }
    }
    s.innerHTML = h;
    const tp = $('#mg-tip4'), host = $('#mg-punkty-ramka');
    s.onpointermove = (e) => {
      const c = e.target.closest('[data-c]'); if (!c) { tp.style.display = 'none'; if (S.hov) hoverArcs(null); return; }
      const p = pts.find((q) => q.c === c.dataset.c);
      tp.innerHTML = `<b>${esc(p.n)}</b><br>nowe mieszkania: <b>${nf(p.x, 1)}</b> na 1000 mieszk. rocznie<br>z Poznania: <b class="mg-o">${nf(p.y, 1)}</b> na 1000 mieszk. rocznie<br>ludność 2025: ${nf(p.pop)}`;
      placeTip(tp, host, e);
    };
