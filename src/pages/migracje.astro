    const max = Math.max(...ARCS.map((a) => a.v));
    for (const a of ARCS) { const n = Math.max(1, Math.round(a.v / max * 20)); for (let i = 0; i < n; i++) PARTS.push({ a, t: Math.random(), sp: .12 + Math.random() * .08 }); }
    sizeCanvas();
  }
  function frame(ts) {
