  .mg-motyl .c { text-align: center; white-space: nowrap; }
  .mg-motyl .s { text-align: right; font-family: var(--mono); font-size: .8rem; font-weight: 600; white-space: nowrap; }
  .mg-motyl small { font-family: var(--mono); font-size: .72rem; color: var(--tekst-2); white-space: nowrap; }

  .mg-tab-ster { display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; }
  .mg-tab-otok { max-height: 520px; overflow-y: auto; }
  #mg-tbody tr { cursor: pointer; }
  #mg-tbody tr[aria-selected='true'] td { background: var(--czerwien-tlo); }
  #mg-tbody td small { color: var(--tekst-3); }

  @media (prefers-reduced-motion: reduce) { svg.mg-plynnie .mg-gm, svg.mg-plynnie .mg-cdz { transition: none; } .mg-fxbtn { display: none; } }
  @media (max-width: 1000px) {
    .mg-glowna { grid-template-columns: minmax(0, 1fr); }
