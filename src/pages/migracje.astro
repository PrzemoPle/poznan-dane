    l += lab(M.poz[0], M.poz[1] + 38 / k, 'Poznań', '', 'middle');
    gA.innerHTML = a; gL.innerHTML = l;
    svg.classList.toggle('hl', !!(S.hov || S.sel) && isOut());
    setParticles();
    $('#mg-legenda').innerHTML = legend();
    $('#mg-mapa-uwaga').textContent = S.dz >= 0
      ? 'Dla pojedynczej dzielnicy GUS pozwala wskazać gminę docelową tylko w powiecie poznańskim; pozostałe gminy są zakreskowane.'
