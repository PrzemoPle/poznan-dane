  /* ---------- panel: karta gminy albo ranking ---------- */
  function panel() {
    let h = '';
    if (S.sel && F[S.sel]) {
      const c = S.sel, f = F[c], s = gsum(c), cur = S.yi === ALL ? -1 : S.yi;
      const mx = Math.max(1, ...f.v.map((v) => Math.max(v[0], v[1])));
      const yy = S.yi === ALL ? ALL - 1 : S.yi, prev = yy > 0 ? f.v[yy - 1][0] : null, now = f.v[yy][0];
      h += `<div class="karta mg-karta"><h3>${esc(f.n)} <small>${esc(f.p)}</small></h3>
        <div class="mg-duze"><div><b class="mg-o">${approx(s.ho, s.o)}${nf(s.o)}</b>z Poznania</div><div><b class="mg-i">${approx(s.hi, s.i)}${nf(s.i)}</b>do Poznania</div><div><b>${sg(s.n)}</b>bilans ${YL()}</div></div>
