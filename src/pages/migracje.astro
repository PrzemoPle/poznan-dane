      const ile = narrow ? 5 : 8;
      top.slice(0, ile).forEach((x) => { l += rad(x.g, narrow ? short(nameOf(x.g.c)) : nameOf(x.g.c), nf(x.v)); });
      if (S.sel && GM[S.sel] && !top.slice(0, ile).find((x) => x.g.c === S.sel)) l += rad(GM[S.sel], nameOf(S.sel), nf(val(S.sel) || 0));
    } else {
      items.sort((p, q) => p.v - q.v);
      const neg = S.mode === 'chg' ? items.slice(-(narrow ? 3 : 5)).reverse().filter((x) => x.v > 0) : items.slice(0, narrow ? 4 : 6);
      const pos = S.mode === 'chg' ? items.slice(0, narrow ? 3 : 5).filter((x) => x.v < 0) : items.slice(narrow ? -2 : -3).filter((x) => x.v > 0);
