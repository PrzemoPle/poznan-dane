    .mg-pasek button { flex: none; }
    .mg-graj { order: -1; }
    .mg-graj span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .mg-male { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mg-motyl { grid-template-columns: minmax(0, 1fr) minmax(6.6em, auto) minmax(0, 1fr) 3.8em; gap: 4px 8px; font-size: .78rem; }
    .mg-waskie { display: none; }
    #mg-tabela th, #mg-tabela td { padding: 8px 7px; }
    #mg-tabela th { letter-spacing: .02em; white-space: normal; line-height: 1.25; }
    #mg-tabela td:first-child { overflow-wrap: anywhere; }
    .mg-fig { padding: 12px; }
  }
</style>

<script>
  import { fmt } from '../lib/wykresy.js';
  import D from '../../data/migracje/dane.json';

  const Y = D.Y, ALL = Y.length, F = D.flows, T = (k) => D.tot[k];
  const DZN = ['Grunwald', 'Jeżyce', 'Nowe Miasto', 'Stare Miasto', 'Wilda'];
  const TRYBY = ['out', 'net', 'chg'], TRYBY_ADRES = ['wyprowadzki', 'bilans', 'zmiana'];
  const POWIAT = '3021', POZNAN = '306401';
  const ZAKRES = `${Y[0]}–${Y[ALL - 1]}`;
  const S = {
    yi: ALL, mode: 'out', dz: -1, sel: null, hov: null, area: 'Poznań', play: null,
    fx: !matchMedia('(prefers-reduced-motion: reduce)').matches, sort: 'o', kier: 'desc',
  };
  const $ = (s) => document.querySelector(s);
  // „−0" po zaokrągleniu wygląda jak błąd, więc wartości bliskie zera pokazujemy jako 0
  const nf = (n, d = 0) => fmt.liczba(Math.abs(n) < 0.5 * 10 ** -d ? 0 : n, d).replace('-', '−');
  const sg = (n, d = 0) => (Math.round(n * 10 ** d) > 0 ? '+' : '') + nf(n, d);
  const pct = (n) => `${sg(n * 100, 1)}%`;
  const yrs = () => (S.yi === ALL ? [...Y.keys()] : [S.yi]);
  const yLab = () => (S.yi === ALL ? `w latach ${ZAKRES}` : `w ${Y[S.yi]} r.`);
  const YL = () => (S.yi === ALL ? ZAKRES : String(Y[S.yi]));
  const cap = (s) => s[0].toUpperCase() + s.slice(1);
  const approx = (h, v) => (h > 0 && v < 100 ? '≈' : '');
  const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const short = (n) => n.replace('Tarnowo Podgórne', 'Tarnowo P.').replace('Murowana Goślina', 'Murowana G.');
  const bezOgonkow = (s) => (s || '').toLowerCase()
    .replace(/ą/g, 'a').replace(/ć/g, 'c').replace(/ę/g, 'e').replace(/ł/g, 'l')
    .replace(/ń/g, 'n').replace(/ó/g, 'o').replace(/ś/g, 's').replace(/[żź]/g, 'z');
  const slug = (s) => bezOgonkow(s).replace(/[^a-z0-9]+/g, '-');

  /* ---------- wartości ---------- */
  function gsum(c, ys = yrs()) {
    let o = 0, i = 0, ho = 0, hi = 0;
    for (const k of ys) { const v = F[c] && F[c].v[k]; if (!v) continue; o += v[0]; i += v[1]; ho += v[3]; hi += v[5]; }
    return { o, i, ho, hi, n: i - o };
  }
  /** Wyprowadzki z jednej dzielnicy do gminy; GUS podaje je tylko dla powiatu poznańskiego. */
  function dzOut(c, z, ys = yrs()) {
    if (!c.startsWith(POWIAT)) return null;
    let o = 0, h = 0;
    for (const k of ys) {
      const p = D.dz[DZN[z]][k].pp[c];
      if (p === undefined) continue;
      if (p < 0) { o += D.avgOut[Y[k]]; h++; } else o += p;      // wartość ujemna = komórka ukryta przez GUS
    }
    return { o, ho: h };
  }
  const cmpYears = () => ((S.yi === ALL || S.yi === 0) ? [0, ALL - 1] : [S.yi - 1, S.yi]);
  function val(c) {
    if (S.dz >= 0) { const r = dzOut(c, S.dz); return r ? r.o : null; }
    if (S.mode === 'chg') { const [a, b] = cmpYears(); return F[c] ? F[c].v[b][0] - F[c].v[a][0] : 0; }
    const s = gsum(c); return S.mode === 'out' ? s.o : s.n;
  }
  const isOut = () => S.mode === 'out' || S.dz >= 0;
  const TH = { o1: [1, 5, 20, 60, 200, 400], oA: [1, 25, 100, 300, 1000, 2000], n1: [3, 15, 60, 200], nA: [10, 50, 250, 1000], c: [3, 10, 30, 60] };
  function fill(v) {
    if (v == null) return 'url(#mg-kreski)';
    const r = Math.round(v);
    if (isOut()) {
      const t = S.yi === ALL ? TH.oA : TH.o1; let k = -1;
      t.forEach((x, i) => { if (r >= x) k = i; });
      return k < 0 ? 'var(--mg-zero)' : `var(--mg-s${k + 1})`;
    }
    const t = S.mode === 'chg' ? TH.c : (S.yi === ALL ? TH.nA : TH.n1); let k = -1;
    t.forEach((x, i) => { if (Math.abs(r) >= x) k = i; });
    if (k < 0) return 'var(--mg-zero)';
    const strata = S.mode === 'chg' ? r > 0 : r < 0;
    return strata ? `var(--mg-n${k + 1})` : `var(--mg-p${k + 1})`;
  }
  const komorki = (cells) => `<div class="mg-leg">${cells.map((c) => `<div><i style="background:${c[0]}"></i><span>${c[1]}</span></div>`).join('')}</div>`;
  function legend() {
    if (isOut()) {
      const t = S.yi === ALL ? TH.oA : TH.o1;
      const cells = [['var(--mg-zero)', '0']].concat(t.map((x, i) => [`var(--mg-s${i + 1})`, `${nf(x)}+`]));
      return `<div class="mg-leg-tytul">Kolor gminy i grubość łuku: osoby wymeldowane ${S.dz >= 0 ? `z dzielnicy ${DZN[S.dz]}` : 'z Poznania'} ${yLab()}</div>${komorki(cells)}`;
    }
    const t = S.mode === 'chg' ? TH.c : (S.yi === ALL ? TH.nA : TH.n1);
    const neg = S.mode === 'chg' ? '+' : '−', pos = S.mode === 'chg' ? '−' : '+';
    const cells = [...t].reverse().map((x, i) => [`var(--mg-n${t.length - i})`, neg + nf(x)])
      .concat([['var(--mg-zero)', '0']], t.map((x, i) => [`var(--mg-p${i + 1})`, pos + nf(x)]));
    const [a, b] = cmpYears();
    const ttl = S.mode === 'chg' ? `Zmiana liczby wyprowadzek: ${Y[b]} wobec ${Y[a]}` : `Bilans wymiany z Poznaniem ${yLab()}`;
    const caps = S.mode === 'chg' ? ['więcej wyprowadzek', 'mniej wyprowadzek'] : ['Poznań traci', 'Poznań zyskuje'];
    return `<div class="mg-leg-tytul">${ttl}</div>${komorki(cells)}<div class="mg-leg-konce"><span>${caps[0]}</span><span>${caps[1]}</span></div>`;
  }

  /* ---------- sterowanie ---------- */
  function seg(el, items, cur, on, dis = []) {
    el.innerHTML = items.map((t, i) => `<button type="button" class="pigulka" aria-pressed="${i === cur}" data-i="${i}"${dis.includes(i) ? ' disabled' : ''}>${t}</button>`).join('');
    el.onclick = (e) => { const b = e.target.closest('button'); if (b && !b.disabled) on(+b.dataset.i); };
  }
  function controls() {
    seg($('#mg-lata'), Y.map(String).concat(['Razem']), S.yi, (i) => { stopPlay(); S.yi = i; render(); });
    $('#mg-lata').lastElementChild.setAttribute('aria-label', `Lata ${ZAKRES} razem`);
    seg($('#mg-tryb'), ['Wyprowadzki', 'Bilans', 'Zmiana rok do roku'], TRYBY.indexOf(S.mode), (i) => { S.mode = TRYBY[i]; if (i) S.dz = -1; render(); });
    seg($('#mg-skad'), ['Cały Poznań'].concat(DZN), S.dz + 1, (i) => setDz(i - 1));
    seg($('#mg-obszar'), ['Cały Poznań'].concat(DZN), S.area === 'Poznań' ? 0 : DZN.indexOf(S.area) + 1, (i) => { S.area = i ? DZN[i - 1] : 'Poznań'; pyramid(); doAdresu(); });
  }
  function setDz(z) { S.dz = z; if (z >= 0) { S.mode = 'out'; if (S.sel && !S.sel.startsWith(POWIAT)) S.sel = null; } render(); }
  function stopPlay() {
    if (S.play) { clearInterval(S.play); S.play = null; }
    $('#mg-graj').setAttribute('aria-pressed', 'false'); $('#mg-graj span').textContent = 'Odtwórz lata';
  }
  $('#mg-graj').onclick = () => {
    if (S.play) { stopPlay(); return; }
    $('#mg-graj').setAttribute('aria-pressed', 'true'); $('#mg-graj span').textContent = 'Zatrzymaj';
    S.yi = 0; render();
    S.play = setInterval(() => { if (S.yi >= ALL - 1) { stopPlay(); return; } S.yi++; render(); }, 1600);
  };
  // strzałki w lewo i w prawo przełączają rok, gdy fokus jest na pasku lat
  $('#mg-lata').addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
    e.preventDefault(); stopPlay();
    S.yi = Math.min(ALL, Math.max(0, S.yi + (e.key === 'ArrowRight' ? 1 : -1)));
    render();
    $('#mg-lata').children[S.yi]?.focus();
  });
  const names = Object.keys(F).map((c) => [F[c].n, c]).sort((a, b) => a[0].localeCompare(b[0], 'pl'));
  $('#mg-gminy').innerHTML = names.map((n) => `<option value="${esc(n[0])}">`).join('');
  $('#mg-szukaj').addEventListener('input', (e) => {
    const v = e.target.value.trim().toLowerCase();
    const hit = names.find((n) => n[0].toLowerCase() === v);
    if (hit) selectG(hit[1]);
  });
  function selectG(c) { if (!F[c]) return; S.sel = c; if (S.dz >= 0 && !c.startsWith(POWIAT)) S.dz = -1; render(); }
  const doMapy = () => $('#mg-mapa-ramka').scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });

  /* ---------- stan w adresie: każdy widok da się podlinkować ---------- */
  function zAdresu() {
    const p = new URLSearchParams(location.search);
    const r = Y.indexOf(Number(p.get('rok'))); if (r >= 0) S.yi = r;
    const m = TRYBY_ADRES.indexOf(p.get('mapa')); if (m >= 0) S.mode = TRYBY[m];
    const z = DZN.findIndex((n) => slug(n) === p.get('dzielnica')); if (z >= 0) { S.dz = z; S.mode = 'out'; }
    const g = p.get('gmina'); if (g && F[g] && (S.dz < 0 || g.startsWith(POWIAT))) S.sel = g;
    const a = DZN.find((n) => slug(n) === p.get('wiek')); if (a) S.area = a;
  }
  function doAdresu() {
    const p = new URLSearchParams();
    if (S.yi < ALL) p.set('rok', Y[S.yi]);
    if (S.mode !== 'out') p.set('mapa', TRYBY_ADRES[TRYBY.indexOf(S.mode)]);
    if (S.dz >= 0) p.set('dzielnica', slug(DZN[S.dz]));
    if (S.sel) p.set('gmina', S.sel);
    if (S.area !== 'Poznań') p.set('wiek', slug(S.area));
    history.replaceState(null, '', `${p.toString() ? `?${p}` : location.pathname}${location.hash}`);
  }
  $('#mg-link').onclick = async () => {
    try { await navigator.clipboard.writeText(location.href.split('#')[0]); $('#mg-link-info').textContent = 'Skopiowano.'; }
    catch { $('#mg-link-info').textContent = 'Skopiuj adres z paska przeglądarki.'; }
    setTimeout(() => { $('#mg-link-info').textContent = ''; }, 2500);
  };

  /* ---------- mapa ---------- */
  const M = D.map, svg = $('#mg-mapa'), tf = M.tf, box = $('#mg-mapa-ramka');
  const GM = {}; M.gm.forEach((g) => { GM[g.c] = g; });
  svg.setAttribute('viewBox', `0 0 ${M.w} ${M.h}`);
  svg.innerHTML = `<defs><pattern id="mg-kreski" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="7" height="7" fill="var(--mg-zero)"/><line x1="0" y1="0" x2="0" y2="7" stroke="var(--linia-mocna)" stroke-width="2.5"/></pattern></defs>
    <g>${M.gm.map((g) => `<path d="${g.d}" data-c="${g.c}" class="mg-gm"/>`).join('')}</g>
    <g>${M.pow.map((p) => `<path d="${p.d}" class="mg-pow${p.c === POWIAT ? ' pp' : ''}"/>`).join('')}</g>
    <g transform="translate(${tf[1]} ${tf[2]}) scale(${tf[0]})">${D.city.dz.map((z, i) => `<path d="${z.d}" data-z="${i}" class="mg-dz"/>`).join('')}</g>
    <g id="mg-gS"></g><g id="mg-gA"></g><g id="mg-gL"></g>`;
  const gA = $('#mg-gA'), gL = $('#mg-gL');
  let ARCS = [];
  const nameOf = (c) => (F[c] ? F[c].n : (c === POZNAN ? 'Poznań' : c));
  const bez = (a, t) => { const u = 1 - t; return [u * u * a.x1 + 2 * u * t * a.cx + t * t * a.x2, u * u * a.y1 + 2 * u * t * a.cy + t * t * a.y2]; };
  function drawMap() {
    const k = (svg.clientWidth || 700) / M.w, narrow = svg.clientWidth < 520;
    for (const p of svg.querySelectorAll('.mg-gm')) { const c = p.dataset.c; p.setAttribute('fill', c === POZNAN ? 'var(--mg-miasto)' : fill(val(c))); }
    $('#mg-gS').innerHTML = S.sel && GM[S.sel] ? `<path class="mg-wybor" d="${GM[S.sel].d}"/>` : '';
    svg.querySelectorAll('.mg-dz').forEach((p, i) => p.classList.toggle('on', i === S.dz));
    const items = M.gm.filter((g) => g.c !== POZNAN).map((g) => ({ g, v: val(g.c) })).filter((x) => x.v != null);
    const fs = 11.5 / k, sw = 3.4 / k;
    const lab = (x, y, t, v, an) => (narrow
      ? `<text x="${x}" y="${y}" font-size="${fs}" stroke-width="${sw}" text-anchor="${an}" font-weight="600">${t}${v ? ` <tspan class="v" font-weight="400">${v}</tspan>` : ''}</text>`
      : `<text x="${x}" y="${y}" font-size="${fs}" stroke-width="${sw}" text-anchor="${an}" font-weight="600">${t}</text>${v ? `<text class="v" x="${x}" y="${y + fs * 1.2}" font-size="${fs * .95}" stroke-width="${sw}" text-anchor="${an}">${v}</text>` : ''}`);
    const rad = (g, t, v) => {
      const dx = g.x - M.poz[0], dy = g.y - M.poz[1], L = Math.hypot(dx, dy) || 1, ux = dx / L, uy = dy / L, off = 11 / k;
      const an = ux > .35 ? 'start' : ux < -.35 ? 'end' : 'middle';
      const y = g.y + uy * off + (uy > .35 ? fs * .9 : uy < -.35 ? -fs * (narrow ? .3 : 1.3) : -fs * .4);
      const w = (narrow ? t.length + (v ? v.length + 1 : 0) : Math.max(t.length, v ? v.length : 0)) * fs * .62, pad = 4 / k;
      let x = g.x + ux * off;
      if (an === 'end') x = Math.max(x, w + pad); else if (an === 'start') x = Math.min(x, M.w - w - pad); else x = Math.min(Math.max(x, w / 2 + pad), M.w - w / 2 - pad);
      return lab(x, y, t, v, an);
    };
    let a = '', l = '';
    ARCS = [];
    if (isOut()) {
      items.sort((p, q) => q.v - p.v);
      const max = items[0] ? items[0].v : 1;
      const top = items.filter((x) => x.v >= max * 0.035).slice(0, 26);
      if (S.sel && GM[S.sel] && !top.find((x) => x.g.c === S.sel)) { const s = items.find((x) => x.g.c === S.sel); if (s && s.v > 0) top.push(s); }
      const o = S.dz >= 0 ? D.dzPts[DZN[S.dz]] : M.poz;
      for (const x of [...top].reverse()) {
        const x1 = o[0], y1 = o[1], x2 = x.g.x, y2 = x.g.y, dx = x2 - x1, dy = y2 - y1;
        const arc = { c: x.g.c, v: x.v, x1, y1, x2, y2, cx: (x1 + x2) / 2 - dy * .22, cy: (y1 + y2) / 2 + dx * .22, w: 1.3 + 8.5 * Math.sqrt(x.v / max) };
        ARCS.push(arc);
        const d = `M${x1} ${y1}Q${arc.cx.toFixed(1)} ${arc.cy.toFixed(1)} ${x2} ${y2}`;
        a += `<path class="mg-lukC" d="${d}" stroke-width="${(arc.w + 3.2).toFixed(2)}"/><path class="mg-luk${x.g.c === S.sel ? ' on' : ''}" data-c="${x.g.c}" d="${d}" stroke-width="${arc.w.toFixed(2)}"/><circle class="mg-kropka" cx="${x2}" cy="${y2}" r="${((2.2 + arc.w * .45) / k).toFixed(2)}"/>`;
      }
      // dla wybranej gminy dokładamy łuk w drugą stronę: przeprowadzki do Poznania
      if (S.sel && GM[S.sel] && S.dz < 0) {
        const s = gsum(S.sel);
        if (s.i > 0) {
          const g = GM[S.sel], x1 = g.x, y1 = g.y, x2 = o[0], y2 = o[1], dx = x2 - x1, dy = y2 - y1, w = 1.3 + 8.5 * Math.sqrt(s.i / max);
          const d = `M${x1} ${y1}Q${((x1 + x2) / 2 - dy * .22).toFixed(1)} ${((y1 + y2) / 2 + dx * .22).toFixed(1)} ${x2} ${y2}`;
          a += `<path class="mg-lukC" d="${d}" stroke-width="${w + 3.2}"/><path class="mg-luk do on" data-c="${S.sel}" d="${d}" stroke-width="${w}"/>`;
        }
