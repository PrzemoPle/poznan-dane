    for (const k of ys) { const r = AG.d[Y[k]][area]; r.a.forEach((v, i) => { a[i][0] += v[0]; a[i][1] += v[1]; }); r.dir.forEach((v, i) => { dir[i] += v; }); }
    return { a, dir };
  }
