  .b27-kpi { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  /* pięć kafli w rzędzie jest węższych niż zwykle cztery — kwota nie może się łamać przed „zł" */
  .b27-kpi .wartosc { white-space: nowrap; font-size: clamp(1.3rem, 1.05rem + 1vw, 1.75rem); }
