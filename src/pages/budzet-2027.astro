---
import Baza from '../layouts/Baza.astro';
import b from '../../data/budzet2027/zbiorcze.json';
import bdl from '../../public/dane/bdl.json';
import zadaniaPlik from '../../public/dane/budzet2027/zadania.json';

const P = b.projekt2027;
const R = b.plan2026;
const hist = bdl.miasta.poznan.wskazniki;
const dzialyHist = bdl.miasta.poznan.dzialy;

const pl = (n, m = 0) => n.toLocaleString('pl-PL', { maximumFractionDigits: m, minimumFractionDigits: m });
const mld = (n) => `${pl(n / 1e9, 2)} mld zł`;
const mln = (n) => (Math.abs(n) < 1e5 && n !== 0 ? `${pl(n, 0)} zł` : `${pl(n / 1e6, 1)} mln zł`);
const zmiana = (a, z) => `${a >= z ? '+' : '−'}${pl(Math.abs((a / z - 1) * 100), 1)}%`;
const odmien = (n, [jeden, kilka, wiele]) => {
  if (n === 1) return jeden;
  const r10 = n % 10, r100 = n % 100;
  return r10 >= 2 && r10 <= 4 && (r100 < 12 || r100 > 14) ? kilka : wiele;
};
const dataPL = (iso) => iso.split('-').reverse().join('.');

const deficyt = -P.wynik;
const deficyt2026 = -R.wynik;
const przyrostDlugu = P.dlug - R.dlug;

// --- dziedziny: 2027 wobec planu 2026
const dziedziny = b.dziedziny.ogolem.pozycje
  .map((d) => ({ ...d, roznica: d.p2027 - d.p2026 }))
  .sort((x, y) => y.roznica - x.roznica);

// --- dochody: grupy z obu części, od największej w 2027 r.
const grupyDochodow = b.dochody.flatMap((s) => s.grupy.map((g) => ({ ...g, sekcja: s.nazwa.includes('MAJĄTKOWE') ? 'majątkowe' : 'bieżące' })));
// „podstwie” to literówka w dokumencie źródłowym — w nazwie pokazujemy poprawną pisownię
const czystaNazwa = (n) => n.replace(/^\d+(\.\d+)*\.\s*/, '').replace(/,? w tym:$/, '').replace('podstwie', 'podstawie');

// --- największe zadania projektowe (inwestycje i projekty)
const najwieksze = zadaniaPlik.zadania.filter((z) => z.r === 'P').sort((x, y) => y.b - x.b).slice(0, 10);
const ileProjektowych = zadaniaPlik.zadania.filter((z) => z.r === 'P').length;
const ileBiezacych = zadaniaPlik.zadania.filter((z) => z.r === 'B').length;
const nazwaJednostki = (s) => s.charAt(0) + s.slice(1).toLowerCase()
  .replace(/\b(poznania|poznań|poznańsk\w+|miasta|urząd|zarząd|wydział|biuro)\b/g, (m) => m)
  .replace(/poznan/g, 'Poznan').replace(/ptbs|zkzl|mopr/g, (m) => m.toUpperCase());

// --- dług: ścieżka i wskaźniki
const lataDlugu = Object.keys(b.prognoza.dlug).filter((r) => Number(r) <= 2034);
const szczytDlugu = Object.entries(b.prognoza.dlug).reduce((a, x) => (x[1] > a[1] ? x : a));
const pierwszaNadwyzka = Object.entries(b.prognoza.wynik).find(([, v]) => v > 0)?.[0];

// --- dane dla narzędzi po stronie przeglądarki (tylko to, czego używają)
const seria = (klucz) => hist[klucz]?.wartosci ?? {};
const daneKlienta = {
  wykonanie: {
    dochody: seria('dochodyOgolem'), wydatki: seria('wydatkiOgolem'),
    wydatkiBiezace: seria('wydatkiBiezace'), wydatkiMajatkowe: seria('wydatkiMajatkowe'),
  },
  plan2026: R,
  prognoza: Object.fromEntries(['dochody', 'wydatki', 'wydatkiBiezace', 'wydatkiMajatkowe', 'wynik', 'dlug', 'nadwyzkaOperacyjna'].map((k) => [k, b.prognoza[k]])),
  inflacja: b.inflacja,
  dziedziny: b.dziedziny,
  dzialy2027: b.dzialy.map(({ kod, nazwa, kwota, biezace, majatkowe }) => ({ kod, nazwa, kwota, biezace, majatkowe })),
  dzialyHistoria: Object.fromEntries(Object.values(dzialyHist).map((d) => [d.klucz, d.wartosci])),
};
const ostatnieWykonanie = Math.max(...Object.keys(seria('wydatkiOgolem')).map(Number));

// „Rekord inwestycji" sprawdzamy na danych, a nie powtarzamy za dokumentem: nominalnie i po odjęciu inflacji.
const doCen2027 = (rok) => {
  let m = 1;
  for (let r = rok + 1; r <= 2027; r++) m *= 1 + b.inflacja[r].w / 100;
  return m;
};
const majatkoweHist = Object.entries(seria('wydatkiMajatkowe')).map(([r, v]) => ({ rok: Number(r), v }));
const rekordNominalny = majatkoweHist.every((x) => x.v < P.wydatkiMajatkowe);
const realnieWiecej = majatkoweHist
  .filter((x) => b.inflacja[x.rok + 1] && x.v * doCen2027(x.rok) > P.wydatkiMajatkowe)
  .sort((x, y) => y.v * doCen2027(y.rok) - x.v * doCen2027(x.rok));
const szczytRealny = realnieWiecej[0];
const rezerwy = 384178896;
---

<Baza
  strona="budzet2027"
  tytul="Budżet 2027 — projekt"
  opis="Projekt budżetu Poznania na 2027 rok: 8,21 mld zł wydatków, 7,13 mld zł dochodów, 1,07 mld zł deficytu. Porównaj z poprzednimi latami, sprawdź inwestycje i ścieżkę długu."
>
  <section style="margin-top:44px">
    <p class="nadtytul">Projekt budżetu · przed głosowaniem Rady Miasta</p>
    <h1>Budżet Poznania na 2027 rok</h1>
    <p class="lid">
      Miasto chce wydać {mld(P.wydatki)} przy {mld(P.dochody)} dochodów. Różnicę — {mld(deficyt)} —
      pokryje głównie kredyt, a dług na koniec roku ma wynieść {mld(P.dlug)}. Na inwestycje
      zaplanowano {mld(P.wydatkiMajatkowe)}{rekordNominalny && (szczytRealny
        ? <> — w złotych najwięcej w historii miasta, ale po odjęciu inflacji więcej wydano
            w {szczytRealny.rok} r. ({mld(szczytRealny.v * doCen2027(szczytRealny.rok))} w cenach z 2027 r.)</>
        : <>, najwięcej w historii miasta</>)}.
    </p>
    <p class="drobne" style="max-width:74ch">
      To <strong>projekt</strong> przedłożony przez Prezydenta, stan na {dataPL(b.meta.stanNa)} — kwoty
      mogą się zmienić do głosowania. Porównania z 2026 r. odnoszą się do planu według stanu na
      30 września 2026 r., a z latami wcześniejszymi — do wykonania budżetu według GUS.
      Co z tego wynika dla porównań, opisujemy w części <a href="#metoda">Metoda i zastrzeżenia</a>.
    </p>
    <nav class="b27-skroty" aria-label="Na tej stronie">
      <a href="#os-czasu">Na osi czasu</a>
      <a href="#rok-do-roku">2027 wobec 2026</a>
      <a href="#dzialy">Porównaj dwa lata</a>
      <a href="#dochody">Dochody</a>
      <a href="#dlug">Deficyt i dług</a>
      <a href="#zadania">Szukaj zadań i inwestycji</a>
    </nav>
  </section>

  <section>
    <div class="siatka b27-kpi">
      <div class="karta kpi">
        <span class="etykieta">Wydatki</span>
        <span class="wartosc">{mld(P.wydatki)}</span>
        <span class="opis">{zmiana(P.wydatki, R.wydatki)} wobec planu 2026</span>
      </div>
      <div class="karta kpi">
        <span class="etykieta">Dochody</span>
        <span class="wartosc">{mld(P.dochody)}</span>
        <span class="opis">bez zmian wobec planu 2026 ({pl((P.dochody / R.dochody - 1) * 100, 2).replace('-', '−')}%)</span>
      </div>
      <div class="karta kpi">
        <span class="etykieta">Inwestycje</span>
        <span class="wartosc">{mld(P.wydatkiMajatkowe)}</span>
        <span class="opis">{zmiana(P.wydatkiMajatkowe, R.wydatkiMajatkowe)}; {pl((P.wydatkiMajatkowe / P.wydatki) * 100, 1)}% wydatków</span>
      </div>
      <div class="karta kpi">
        <span class="etykieta">Deficyt</span>
        <span class="wartosc">{mld(deficyt)}</span>
        <span class="opis">w planie 2026: {mld(deficyt2026)}</span>
      </div>
      <div class="karta kpi">
        <span class="etykieta">Dług na koniec roku</span>
        <span class="wartosc">{mld(P.dlug)}</span>
        <span class="opis">o {mld(przyrostDlugu)} więcej; {pl((P.dlug / P.dochody) * 100, 1)}% dochodów</span>
      </div>
    </div>
  </section>

  <section id="os-czasu">
    <h2>Na osi czasu</h2>
    <p class="drobne" style="margin-top:-8px;max-width:74ch">
      Jedna wielkość przez wszystkie lata: to, co miasto faktycznie wykonało, plan na 2026 r., projekt
      na 2027 r. i prognoza z wieloletniej prognozy finansowej. Przełącz na ceny z 2027 r., żeby
      odjąć inflację — bez tego 1 mld zł z 2010 r. i z 2027 r. wyglądają na tyle samo.
    </p>
    <div class="karta cien" style="padding:16px 18px">
      <div class="b27-pasek" role="group" aria-label="Wielkość">
        <button class="pigulka" data-miara="wydatki" aria-pressed="true">Wydatki</button>
        <button class="pigulka" data-miara="dochody" aria-pressed="false">Dochody</button>
        <button class="pigulka" data-miara="wynik" aria-pressed="false">Nadwyżka / deficyt</button>
        <button class="pigulka" data-miara="wydatkiMajatkowe" aria-pressed="false">Inwestycje</button>
        <button class="pigulka" data-miara="wydatkiBiezace" aria-pressed="false">Wydatki bieżące</button>
        <button class="pigulka" data-miara="dlug" aria-pressed="false">Dług</button>
      </div>
      <div class="b27-pasek" style="margin-top:10px">
        <label class="b27-wybor">Kwoty
          <select id="oc-ceny">
            <option value="nominalne">nominalne (jak w dokumentach)</option>
            <option value="realne">w cenach z 2027 r.</option>
          </select>
        </label>
        <label class="b27-wybor">Zakres
          <select id="oc-zakres">
            <option value="2012-2034">2012–2034</option>
            <option value="2003-2040">2003–2040</option>
            <option value="2003-2050">2003–2050 (cała prognoza)</option>
          </select>
        </label>
      </div>
      <div id="oc-wykres" style="margin-top:14px"><p class="ladowanie">…</p></div>
      <ul class="b27-legenda" aria-label="Legenda">
        <li><i class="k-wykonanie"></i>wykonanie (GUS)</li>
        <li><i class="k-plan"></i>plan 2026</li>
        <li><i class="k-projekt"></i>projekt 2027</li>
        <li><i class="k-prognoza"></i>prognoza WPF</li>
      </ul>
      <p class="drobne" id="oc-uwaga" style="margin:10px 0 0"></p>
    </div>

    <div class="karta" style="margin-top:14px">
      <div class="b27-pasek">
        <label class="b27-wybor" style="font-size:.95rem">Porównaj projekt 2027 z rokiem
          <select id="oc-rok"></select>
        </label>
      </div>
      <div class="tabela-otok" style="margin-top:12px">
        <table>
          <thead>
            <tr><th>Wielkość</th><th class="num" id="oc-th-rok">—</th><th class="num">Projekt 2027</th>
              <th class="num">Zmiana</th><th class="num">Zmiana po odjęciu inflacji</th></tr>
          </thead>
          <tbody id="oc-tbody"><tr><td colspan="5" class="ladowanie">…</td></tr></tbody>
        </table>
      </div>
      <p class="drobne" id="oc-opis-roku" style="margin:10px 0 0"></p>
    </div>
  </section>

  <section id="rok-do-roku">
    <h2>2027 wobec 2026: na co więcej, na co mniej</h2>
    <p class="drobne" style="margin-top:-8px;max-width:74ch">
      Wydatki w 13 dziedzinach, tak jak dzieli je uzasadnienie do projektu. Pasek w prawo to wzrost,
      w lewo — spadek wobec planu na 2026 r.
    </p>
    <div class="karta cien" style="padding:16px 18px">
      <div class="b27-pasek" role="group" aria-label="Rodzaj wydatków">
        <button class="pigulka" data-rdr="ogolem" aria-pressed="true">Wszystkie wydatki</button>
        <button class="pigulka" data-rdr="biezace" aria-pressed="false">Bieżące</button>
        <button class="pigulka" data-rdr="majatkowe" aria-pressed="false">Inwestycje</button>
      </div>
      <ol class="b27-roznice" id="rdr-lista">
        {dziedziny.map((d) => {
          const maks = Math.max(...dziedziny.map((x) => Math.abs(x.roznica)));
          const w = (Math.abs(d.roznica) / maks) * 50;
          return (
            <li>
              <span class="b27-r-nazwa">{d.nazwa}</span>
              <span class="b27-r-os"><i class={d.roznica >= 0 ? 'plus' : 'minus'} style={`width:${w}%;${d.roznica >= 0 ? 'left:50%' : `left:${50 - w}%`}`}></i></span>
              <span class="b27-r-wartosc">{d.roznica >= 0 ? '+' : '−'}{pl(Math.abs(d.roznica) / 1e6, 1)} mln zł
                <small>{pl(d.p2026 / 1e6, 0)} → {pl(d.p2027 / 1e6, 0)} mln · {zmiana(d.p2027, d.p2026)}</small></span>
            </li>
          );
        })}
      </ol>
      <p class="drobne" style="margin:12px 0 0;max-width:74ch">
        Część różnic nie oznacza zmiany polityki miasta. Dotacje z budżetu państwa (zwłaszcza na
        politykę społeczną) są dopisywane w trakcie roku, więc plan z września jest pod tym względem
        pełniejszy niż projekt. Od 2027 r. obowiązuje też nowa klasyfikacja budżetowa — m.in. zakupy
        drobnego sprzętu liczą się odtąd do wydatków majątkowych.
      </p>
    </div>

    <div class="siatka k2" style="margin-top:14px;align-items:start">
      <div class="karta">
        <h3>Z czego składają się wydatki</h3>
        <p class="drobne" style="margin-top:-6px">Podział według rodzaju wydatku, cały budżet na 2027 r.</p>
        <ol class="ranking">
          {[...b.ekonomiczne].sort((x, y) => y.kwota - x.kwota).map((e, i, wszystkie) => (
            <li style={`--i:${i}`}>
              <span class="r-nazwa">{e.nazwa}</span>
              <span class="r-pasek"><i style={`width:${Math.max(1.5, (e.kwota / wszystkie[0].kwota) * 100)}%;background:${e.rodzaj === 'majątkowe' ? 'var(--czerwien)' : 'var(--blekit)'}`}></i></span>
              <span class="r-wartosc">{mln(e.kwota)}</span>
            </li>
          ))}
        </ol>
        <p class="drobne" style="margin:10px 0 0">Niebieskie — wydatki bieżące, czerwone — majątkowe.</p>
      </div>
      <div class="karta">
        <h3>Największe zadania inwestycyjne i projekty</h3>
        <p class="drobne" style="margin-top:-6px">Kwoty zaplanowane na sam 2027 r.</p>
        <ol class="ranking">
          {najwieksze.map((z, i) => (
            <li style={`--i:${i}`}>
              <span class="r-nazwa">{z.n} <span class="drobne">({nazwaJednostki(z.j)})</span></span>
              <span class="r-pasek"><i style={`width:${Math.max(1.5, (z.b / najwieksze[0].b) * 100)}%;background:var(--czerwien)`}></i></span>
              <span class="r-wartosc">{mln(z.b)}</span>
            </li>
          ))}
        </ol>
        <p class="drobne" style="margin:10px 0 0"><a href="#zadania">Szukaj wśród wszystkich {ileProjektowych} zadań</a></p>
      </div>
    </div>
  </section>

  <section id="dzialy">
    <h2>Porównaj dwa lata</h2>
    <p class="drobne" style="margin-top:-8px;max-width:74ch">
      Wydatki według działów klasyfikacji budżetowej — tego samego podziału, w którym GUS podaje
      wykonanie budżetu od 2008 r. Wybierz rok do zestawienia z projektem 2027 i sposób liczenia.
    </p>
    <div class="karta cien" style="padding:16px 18px">
      <div class="b27-pasek">
        <label class="b27-wybor">Projekt 2027 wobec roku
          <select id="dz-rok"></select>
        </label>
        <label class="b27-wybor">Pokaż
          <select id="dz-tryb">
            <option value="kwoty">kwoty</option>
            <option value="realne">kwoty w cenach z 2027 r.</option>
            <option value="udzial">udział w wydatkach</option>
          </select>
        </label>
      </div>
      <div class="tabela-otok" style="margin-top:12px">
        <table id="dz-tabela">
          <thead>
            <tr><th>Dział</th><th class="num" id="dz-th-rok">—</th><th class="num">Projekt 2027</th><th class="num">Zmiana</th></tr>
          </thead>
          <tbody id="dz-tbody"><tr><td colspan="4" class="ladowanie">…</td></tr></tbody>
        </table>
      </div>
      <p class="drobne" style="margin:10px 0 0">Kliknij dział, żeby zobaczyć jego wydatki rok po roku.</p>
      <div id="dz-szczegol" hidden style="margin-top:14px">
        <h3 id="dz-szczegol-tytul" style="margin-bottom:4px"></h3>
        <div id="dz-wykres"></div>
      </div>
      <p class="drobne" style="margin:12px 0 0;max-width:74ch">
        Trzy rzeczy, o których trzeba pamiętać, czytając tę tabelę. Po pierwsze, lata do {ostatnieWykonanie} r.
        to pieniądze faktycznie wydane, a 2027 r. to plan, który może zostać wykonany tylko w części —
        dotyczy to zwłaszcza inwestycji. Po drugie, w projekcie {mln(rezerwy)} rezerw stoi w dziale „Różne rozliczenia";
        w ciągu roku rozchodzą się po pozostałych działach, więc dziś te działy wyglądają na mniejsze,
        niż będą. Po trzecie, od 2027 r. obowiązuje nowa klasyfikacja budżetowa.
      </p>
    </div>
  </section>

  <section id="dochody">
    <h2>Skąd miasto weźmie pieniądze</h2>
    <p class="drobne" style="margin-top:-8px;max-width:74ch">
      Dochody według źródeł, plan 2026 i projekt 2027. Ponad połowa to udział w podatku PIT
      ({mld(b.prognoza.pit['2027'])}, {pl((b.prognoza.pit['2027'] / P.dochody) * 100, 1)}% dochodów).
      Rozwiń grupę, żeby zobaczyć jej składniki.
    </p>
    <div class="tabela-otok">
      <table class="b27-dochody">
        <thead>
          <tr><th>Źródło</th><th class="num">Plan 2026</th><th class="num">Projekt 2027</th><th class="num">Zmiana</th></tr>
        </thead>
        <tbody>
          <tr class="b27-suma"><td>Dochody ogółem</td><td class="num">{mln(R.dochody)}</td><td class="num">{mln(P.dochody)}</td><td class="num">{zmiana(P.dochody, R.dochody)}</td></tr>
          {['bieżące', 'majątkowe'].map((sekcja) => (
            <>
              <tr class="b27-sekcja"><td>Dochody {sekcja}</td>
                <td class="num">{mln(sekcja === 'bieżące' ? R.dochodyBiezace : R.dochodyMajatkowe)}</td>
                <td class="num">{mln(sekcja === 'bieżące' ? P.dochodyBiezace : P.dochodyMajatkowe)}</td>
                <td class="num">{zmiana(sekcja === 'bieżące' ? P.dochodyBiezace : P.dochodyMajatkowe, sekcja === 'bieżące' ? R.dochodyBiezace : R.dochodyMajatkowe)}</td></tr>
              {grupyDochodow.filter((g) => g.sekcja === sekcja).sort((x, y) => y.p2027 - x.p2027).map((g) => {
                const skladniki = (g.podgrupy?.length ? g.podgrupy.flatMap((p) => p.pozycje ?? []) : g.pozycje) ?? [];
                return (
                  <tr>
                    <td>
                      {skladniki.length > 1 ? (
                        <details>
                          <summary>{czystaNazwa(g.nazwa)}</summary>
                          <ul class="b27-skladniki">
                            {[...skladniki].sort((x, y) => y.p2027 - x.p2027).map((s) => (
                              <li><span>{s.nazwa}</span><span class="num">{mln(s.p2026)} → <strong>{mln(s.p2027)}</strong></span></li>
                            ))}
                          </ul>
                        </details>
                      ) : czystaNazwa(g.nazwa)}
                    </td>
                    <td class="num">{mln(g.p2026)}</td>
                    <td class="num">{mln(g.p2027)}</td>
                    <td class="num">{g.p2026 > 0 ? zmiana(g.p2027, g.p2026) : '—'}</td>
                  </tr>
                );
              })}
            </>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="dlug">
    <h2>Deficyt i dług</h2>
    <div class="siatka k2" style="align-items:start">
      <div class="karta">
        <h3>Jak domyka się budżet</h3>
        <p style="margin-top:0">
          Wydatki przewyższają dochody o {mld(deficyt)}. Do tego miasto musi w 2027 r. spłacić
          {mln(b.finansowanie.rozchody.reduce((s, x) => s + x.kwota, 0))} wcześniejszych zobowiązań
          i pożyczek. Razem trzeba więc znaleźć {mld(b.finansowanie.przychody.reduce((s, x) => s + x.kwota, 0))}:
        </p>
        <ol class="ranking">
          {b.finansowanie.przychody.map((x, i) => (
            <li style={`--i:${i}`}>
              <span class="r-nazwa">{x.nazwa}</span>
              <span class="r-pasek"><i style={`width:${Math.max(1.5, (x.kwota / b.finansowanie.przychody[0].kwota) * 100)}%;background:var(--czerwien)`}></i></span>
              <span class="r-wartosc">{mln(x.kwota)}</span>
            </li>
          ))}
        </ol>
        <p class="drobne" style="margin:12px 0 0">
          Bieżące dochody wciąż pokrywają bieżące wydatki z zapasem {mln(P.nadwyzkaOperacyjna)}
          (w planie 2026: {mln(R.nadwyzkaOperacyjna)}). Deficyt bierze się w całości z inwestycji.
        </p>
      </div>
      <div class="karta">
        <h3>Dług miasta według prognozy</h3>
        <div id="dl-wykres"><p class="ladowanie">…</p></div>
        <p class="drobne" style="margin:10px 0 0">
          Na koniec 2026 r. — {mld(R.dlug)} (plan), na koniec 2027 r. — {mld(P.dlug)}. Według prognozy
          dług rośnie do {szczytDlugu[0]} r. ({mld(szczytDlugu[1])}), a od {pierwszaNadwyzka} r. budżet ma mieć
          nadwyżki i dług zacznie spadać. Warunkiem jest ograniczenie inwestycji z {mld(P.wydatkiMajatkowe)}
          w 2027 r. do {mld(b.prognoza.wydatkiMajatkowe['2031'])} w 2031 r.
        </p>
      </div>
    </div>
    <div class="tabela-otok" style="margin-top:14px">
      <table>
        <thead>
          <tr><th>Rok</th><th class="num">Dochody</th><th class="num">Wydatki</th><th class="num">w tym inwestycje</th>
            <th class="num">Wynik</th><th class="num">Dług na koniec roku</th><th class="num">Dług do dochodów</th>
            <th class="num" title="Spłaty rat i odsetek w relacji do dochodów bieżących; w nawiasie ustawowy limit dla Poznania">Obsługa długu (limit)</th></tr>
        </thead>
        <tbody>
          {lataDlugu.map((r) => (
            <tr class={r === '2027' ? 'b27-wiersz-projekt' : undefined}>
              <td>{r}{r === '2027' ? ' — projekt' : ''}</td>
              <td class="num">{mld(b.prognoza.dochody[r])}</td>
              <td class="num">{mld(b.prognoza.wydatki[r])}</td>
              <td class="num">{mld(b.prognoza.wydatkiMajatkowe[r])}</td>
              <td class="num">{b.prognoza.wynik[r] >= 0 ? '+' : '−'}{pl(Math.abs(b.prognoza.wynik[r]) / 1e6, 0)} mln zł</td>
              <td class="num">{mld(b.prognoza.dlug[r])}</td>
              <td class="num">{pl((b.prognoza.dlug[r] / b.prognoza.dochody[r]) * 100, 1)}%</td>
              <td class="num">{pl(b.prognoza.wskaznikSplaty[r], 2)}% ({pl(b.prognoza.limitSplaty[r], 2)}%)</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="drobne" style="margin-top:8px;max-width:74ch">
      Lata po 2027 to prognoza miasta, a nie zobowiązanie: zakłada m.in. inflację {pl(b.makro['2028'].inflacja, 1)}%
      i wzrost PKB o {pl(b.makro['2028'].pkb, 1)}% w 2028 r. Wieloletnia prognoza finansowa jest aktualizowana
      co najmniej raz w roku.
    </p>
  </section>

  <section id="zadania">
    <h2>Szukaj zadań i inwestycji</h2>
    <p class="drobne" style="margin-top:-8px;max-width:74ch">
      {ileProjektowych} zadań inwestycyjnych i projektów oraz {ileBiezacych} zadań bieżących z opisami
      z materiałów do projektu. Wpisz nazwę ulicy, osiedla, szkoły albo instytucji — szukamy także
      w opisach, bo drobniejsze inwestycje są wymienione dopiero tam. Odmiana nie przeszkadza:
      „Bobrownicka" znajdzie też „w ul. Bobrownickiej".
    </p>
    <div class="karta cien" style="padding:16px 18px">
      <div class="b27-pasek" role="group" aria-label="Rodzaj zadań">
        <button class="pigulka" data-typ="P" aria-pressed="true">Inwestycje i projekty ({ileProjektowych})</button>
        <button class="pigulka" data-typ="B" aria-pressed="false">Zadania bieżące ({ileBiezacych})</button>
      </div>
      <div class="siatka" style="grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px;margin-top:12px">
        <label class="pole" style="grid-column:span 2">Szukaj w nazwach i opisach
          <input type="search" id="z-fraza" placeholder="np. Bobrownicka, Teatr Muzyczny, chodnik, Naramowice" autocomplete="off" />
        </label>
        <label class="pole">Jednostka
          <select id="z-jednostka"><option value="">wszystkie</option></select>
        </label>
        <label class="pole">Kolejność
          <select id="z-sort">
            <option value="kwota">od największej kwoty</option>
            <option value="wzrost" data-tylko="B">największy wzrost wobec 2026</option>
            <option value="spadek" data-tylko="B">największy spadek wobec 2026</option>
            <option value="nazwa">alfabetycznie</option>
          </select>
        </label>
      </div>
      <p class="drobne" id="z-licznik" style="margin:10px 0 0" aria-live="polite">Wczytywanie zadań…</p>
    </div>
    <div id="z-lista" class="b27-zadania"></div>
    <div style="text-align:center;margin-top:16px">
      <button id="z-wiecej" class="glowny" hidden>Pokaż więcej</button>
    </div>
  </section>

  <hr class="rozdz" />

  <section id="metoda">
    <h2>Metoda i zastrzeżenia</h2>
    <div class="siatka k2" style="align-items:start">
      <div>
        <h3>Skąd są dane</h3>
        <p>
          Z dokumentów, które Prezydent przedłożył Radzie Miasta i opublikował w
          <a href={b.meta.bip} rel="noopener">Biuletynie Informacji Publicznej</a>: projektu uchwały
          budżetowej z załącznikami, uzasadnienia, materiałów informacyjnych oraz projektu wieloletniej
          prognozy finansowej. Wykonanie budżetu z lat wcześniejszych pochodzi z Banku Danych Lokalnych GUS,
          a inflacja do 2025 r. — z GUS (wskaźnik cen towarów i usług konsumpcyjnych dla Polski).
        </p>
        <h3>Jak sprawdzono liczby</h3>
        <p>
          Część dokumentów to skany, więc każdą tabelę sprawdzono sumami kontrolnymi: rozdziały muszą dać
          dział, działy — sekcję, a sekcje — {mld(P.wydatki)}; wydatki bieżące i majątkowe muszą dać razem
          całość w każdej z 13 dziedzin; dochody minus wydatki — wynik w każdym roku prognozy; a dług
          na koniec roku — dług z poprzedniego roku plus kredyty minus spłaty. Wszystkie te rachunki
          zgadzają się co do grosza.
        </p>
        <h3>Ceny z 2027 r.</h3>
        <p>
          Przeliczenie „po odjęciu inflacji" używa wskaźnika cen GUS za lata 2003–2025. Dla 2026 r.
          przyjęto {pl(b.inflacja['2026'].w, 1)}%, a dla 2027 r. — {pl(b.inflacja['2027'].w, 1)}%, tak jak w założeniach
          projektu budżetu; dla lat późniejszych — założenia z prognozy finansowej. To przybliżenie:
          koszty miasta (płace, energia, budowy) nie rosną dokładnie tak jak ceny w sklepach.
        </p>
      </div>
      <div>
        <h3>Czego nie wolno z tych liczb wnioskować</h3>
        <ul>
          <li><strong>Plan to nie wykonanie.</strong> Lata do {ostatnieWykonanie} r. pokazują pieniądze wydane, 2026 r. — plan
            z września, 2027 r. — projekt. Plan może zostać wykonany tylko w części, zwłaszcza w inwestycjach.</li>
          <li><strong>Projekt a plan z września.</strong> Dotacje z budżetu państwa są dopisywane w ciągu roku,
            dlatego dochody i część wydatków w projekcie są zaniżone względem tego, co pokaże plan za rok.
            Miasto podaje, że wobec <em>projektu</em> na 2026 r. dochody rosną o 7,6%, a wydatki o 10,6%.</li>
          <li><strong>Nowa klasyfikacja budżetowa.</strong> Od 2027 r. obowiązuje nowe rozporządzenie o klasyfikacji
            dochodów i wydatków. Zestawienia według działów z latami wcześniejszymi są przez to przybliżone.</li>
          <li><strong>Kolumna 2026 przy zadaniach bieżących</strong> nie obejmuje zadań, na które w 2027 r. nie ma
            pieniędzy — dokument ich nie wymienia. Zadania inwestycyjne mają tylko kwotę na 2027 r.</li>
          <li><strong>Suma zadań</strong> z wykazów to {mln(zadaniaPlik.zadania.reduce((s, z) => s + z.b, 0))} wobec {mln(P.wydatki)}
            wydatków w projekcie uchwały. Różnicy dokumenty nie objaśniają.</li>
        </ul>
        <h3>Kiedy strona się zmieni</h3>
        <p>
          Po autopoprawkach i po uchwaleniu budżetu przez Radę Miasta dane trzeba wczytać ponownie —
          dokumenty są plikami PDF, więc nie dzieje się to automatycznie. Datę stanu danych podajemy
          na górze strony.
        </p>
      </div>
    </div>
  </section>

  <script type="application/json" id="b27-dane" set:html={JSON.stringify(daneKlienta)} />
</Baza>

<style is:global>
