  .b27-legenda li { display: inline-flex; align-items: center; gap: 7px; }
  .b27-legenda i { width: 14px; height: 11px; border-radius: 1px; display: inline-block; box-sizing: border-box; }
  .b27-legenda i.k-wykonanie { background: var(--blekit); }
  .b27-legenda i.k-plan { background: var(--tekst-3); }
  .b27-legenda i.k-projekt { background: var(--czerwien); }
  .b27-legenda i.k-prognoza { background: var(--czerwien-tlo); border: 1.5px dashed var(--czerwien); }

  /* różnice rok do roku: oś pośrodku, pasek w prawo = wzrost */
  .b27-roznice { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 9px; }
  .b27-roznice li { display: grid; grid-template-columns: minmax(0, 15rem) minmax(80px, 1fr) minmax(0, 13.5rem); gap: 12px; align-items: center; }
  .b27-r-nazwa { color: var(--tekst-2); line-height: 1.3; text-wrap: pretty; }
  .b27-r-os { position: relative; height: 16px; background: linear-gradient(var(--linia-mocna), var(--linia-mocna)) 50% 0 / 1px 100% no-repeat; }
  .b27-r-os i { position: absolute; top: 2px; bottom: 2px; border-radius: 2px; min-width: 2px; }
  .b27-r-os i.plus { background: var(--blekit); }
  .b27-r-os i.minus { background: var(--zloto); }
