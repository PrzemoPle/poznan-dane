  #dz-tbody tr { cursor: pointer; }
  #dz-tbody tr:hover td { background: var(--akcent-tlo); }
  #dz-tbody tr[aria-selected='true'] td { background: var(--czerwien-tlo); }
  .b27-dz-pasek { display: block; height: 4px; margin-top: 5px; background: var(--linia); border-radius: 2px; overflow: hidden; }
  .b27-dz-pasek i { display: block; height: 100%; background: var(--czerwien); border-radius: 2px; }
