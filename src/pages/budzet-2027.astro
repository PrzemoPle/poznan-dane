  .b27-skladniki { list-style: none; margin: 8px 0 4px; padding: 0; display: grid; gap: 5px; font-size: .84rem; color: var(--tekst-2); }
  .b27-skladniki li { display: flex; justify-content: space-between; gap: 14px; border-top: 1px solid var(--linia); padding-top: 5px; }
  .b27-skladniki .num { white-space: nowrap; font-family: var(--mono); font-size: .78rem; }
