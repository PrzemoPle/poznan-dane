  .b27-etap p { grid-column: 1 / -1; margin: 0; font-size: .86rem; color: var(--tekst-2); white-space: pre-line; line-height: 1.5; }
  .b27-z-zrodlo { font-size: .76rem; color: var(--tekst-3); }
</style>

<script>
  import { slupkowy, fmt, podmien } from '../lib/wykresy.js';

  const D = JSON.parse(document.querySelector('#b27-dane').textContent);
  const $ = (s) => document.querySelector(s);
  const mln = (n, m = 1) => `${fmt.liczba(n / 1e6, m)} mln zł`;
  const znak = (n) => (n >= 0 ? '+' : '−');
  const procZmiany = (a, z) => (z ? `${znak(a - z)}${fmt.liczba(Math.abs((a / z - 1) * 100), 1)}%` : '—');

  // ---------- ceny stałe ----------
  // Mnożnik, który sprowadza kwotę z danego roku do cen z 2027 r. Przed 2027 mnożymy przez
  // inflację lat następnych, po 2027 dzielimy przez inflację lat, które dopiero nadejdą.
  const ROK_CEN = 2027;
  const lataInflacji = Object.keys(D.inflacja).map(Number);
  const INFL_OD = Math.min(...lataInflacji);
  function doCen2027(rok) {
    let m = 1;
    if (rok < ROK_CEN) for (let r = rok + 1; r <= ROK_CEN; r++) m *= 1 + D.inflacja[r].w / 100;
    else for (let r = ROK_CEN + 1; r <= rok; r++) m /= 1 + D.inflacja[r].w / 100;
    return m;
  }
  const maInflacje = (rok) => rok >= INFL_OD - 1 && rok <= Math.max(...lataInflacji);

  // ---------- jedna wielkość, wszystkie lata ----------
  const MIARY = {
    wydatki: 'Wydatki', dochody: 'Dochody', wynik: 'Nadwyżka albo deficyt',
    wydatkiMajatkowe: 'Wydatki majątkowe (inwestycje)', wydatkiBiezace: 'Wydatki bieżące', dlug: 'Dług na koniec roku',
  };
  /** Wartość i jej rodzaj dla danego roku; null, gdy źródła jej nie podają. */
  function wartosc(miara, rok) {
    const r = String(rok);
    if (rok >= 2027) return D.prognoza[miara]?.[r] != null ? { v: D.prognoza[miara][r], rodzaj: rok === 2027 ? 'projekt' : 'prognoza' } : null;
    if (rok === 2026) return D.plan2026[miara] != null ? { v: D.plan2026[miara], rodzaj: 'plan' } : null;
    if (miara === 'wynik') {
      const d = D.wykonanie.dochody[r], w = D.wykonanie.wydatki[r];
      return d != null && w != null ? { v: d - w, rodzaj: 'wykonanie' } : null;
    }
    const v = D.wykonanie[miara]?.[r];
    return v != null ? { v, rodzaj: 'wykonanie' } : null;
  }

  let miara = 'wydatki';
  function rysujOs() {
    const realnie = $('#oc-ceny').value === 'realne';
    const [od, doK] = $('#oc-zakres').value.split('-').map(Number);
    const dane = [];
    for (let rok = od; rok <= doK; rok++) {
      const w = wartosc(miara, rok);
      if (!w || (realnie && !maInflacje(rok))) continue;
      const v = realnie ? w.v * doCen2027(rok) : w.v;
      dane.push([String(rok), v, `k-${w.rodzaj}`, rok === 2027 ? fmt.skrot(v) : null]);
    }
    podmien('#oc-wykres', (szer) => slupkowy(dane, { wysokosc: szer < 520 ? 240 : 300, szerokosc: szer }));
    const uwagi = [];
    if (miara === 'dlug') uwagi.push('Dług pokazujemy od 2026 r. — wcześniejszych lat nie ma w dokumentach projektu.');
    if (miara === 'wydatkiBiezace') uwagi.push('GUS podaje wydatki bieżące od 2008 r.');
    if (realnie) uwagi.push('Kwoty przeliczone na ceny z 2027 r.; lata 2026–2050 według założeń inflacji z dokumentów budżetowych.');
    $('#oc-uwaga').textContent = uwagi.join(' ');
    $('#oc-uwaga').hidden = !uwagi.length;
  }
  for (const btn of document.querySelectorAll('[data-miara]')) {
    btn.addEventListener('click', () => {
      miara = btn.dataset.miara;
      for (const x of document.querySelectorAll('[data-miara]')) x.setAttribute('aria-pressed', String(x === btn));
      rysujOs();
    });
  }
  $('#oc-ceny').addEventListener('change', rysujOs);
  $('#oc-zakres').addEventListener('change', rysujOs);

  // ---------- projekt 2027 wobec wybranego roku ----------
  const lataWykonania = Object.keys(D.wykonanie.wydatki).map(Number).sort((a, b) => b - a);
  const wyborRoku = $('#oc-rok');
  wyborRoku.append(new Option('2026 (plan)', '2026'));
  for (const r of lataWykonania) wyborRoku.append(new Option(`${r} (wykonanie)`, String(r)));
  function tabelaRoku() {
    const rok = Number(wyborRoku.value);
    $('#oc-th-rok').textContent = rok === 2026 ? 'Plan 2026' : `Wykonanie ${rok}`;
    const wiersze = ['dochody', 'wydatki', 'wydatkiBiezace', 'wydatkiMajatkowe', 'wynik'].map((m) => {
      const a = wartosc(m, rok), z = wartosc(m, 2027);
      const tr = document.createElement('tr');
      const komorki = [MIARY[m]];
      const zeZnakiem = (v) => `${znak(v)}${fmt.kwota(Math.abs(v))}`;
      if (!a) komorki.push('brak danych', fmt.kwota(z.v), '—', '—');
      else if (m === 'wynik') {
        // przy wyniku procent nie ma sensu (zmiana znaku), więc podajemy różnicę w złotych
        const real = maInflacje(rok) ? a.v * doCen2027(rok) : null;
        komorki.push(zeZnakiem(a.v), zeZnakiem(z.v), zeZnakiem(z.v - a.v), real == null ? '—' : zeZnakiem(z.v - real));
      } else {
        const real = maInflacje(rok) ? a.v * doCen2027(rok) : null;
        komorki.push(fmt.kwota(a.v), fmt.kwota(z.v), procZmiany(z.v, a.v), real == null ? '—' : procZmiany(z.v, real));
      }
      komorki.forEach((t, i) => { const td = document.createElement('td'); td.textContent = t; if (i) td.className = 'num'; tr.append(td); });
      return tr;
    });
    $('#oc-tbody').replaceChildren(...wiersze);
    const w = wartosc('wydatki', rok);
    const opis = $('#oc-opis-roku');
    if (w && maInflacje(rok)) {
      const real = w.v * doCen2027(rok);
      opis.textContent = `Ceny wzrosły między ${rok} a 2027 r. o ${fmt.liczba((doCen2027(rok) - 1) * 100, 0)}%`
        + `${rok >= 2025 ? ' (częściowo według prognozy)' : ''}. Wydatki z ${rok} r. to w cenach z 2027 r. ${fmt.kwota(real)}`
        + ` — projekt na 2027 r. jest od nich ${real < D.prognoza.wydatki['2027'] ? 'wyższy' : 'niższy'} o ${fmt.liczba(Math.abs(D.prognoza.wydatki['2027'] / real - 1) * 100, 1)}%.`
        + (rok === 2026 ? '' : ' Porównujemy tu jednak plan z wykonaniem.');
    } else opis.textContent = 'Dla tego roku nie mamy wskaźnika cen GUS, więc zmiany realnej nie liczymy.';
  }
  wyborRoku.addEventListener('change', tabelaRoku);

  // ---------- 2027 wobec 2026 w dziedzinach ----------
  function rysujRoznice(klucz) {
    const poz = D.dziedziny[klucz].pozycje.map((d) => ({ ...d, r: d.p2027 - d.p2026 })).sort((a, b) => b.r - a.r);
    const maks = Math.max(...poz.map((d) => Math.abs(d.r)));
    $('#rdr-lista').replaceChildren(...poz.map((d) => {
      const li = document.createElement('li');
      const w = (Math.abs(d.r) / maks) * 50;
      const nazwa = Object.assign(document.createElement('span'), { className: 'b27-r-nazwa', textContent: d.nazwa });
      const os = Object.assign(document.createElement('span'), { className: 'b27-r-os' });
      const pasek = document.createElement('i');
      pasek.className = d.r >= 0 ? 'plus' : 'minus';
      pasek.style.width = `${w}%`;
      pasek.style.left = d.r >= 0 ? '50%' : `${50 - w}%`;
      os.append(pasek);
      const wart = Object.assign(document.createElement('span'), { className: 'b27-r-wartosc', textContent: `${znak(d.r)}${mln(Math.abs(d.r))}` });
      wart.append(Object.assign(document.createElement('small'), {
        textContent: `${fmt.liczba(d.p2026 / 1e6, 0)} → ${fmt.liczba(d.p2027 / 1e6, 0)} mln · ${procZmiany(d.p2027, d.p2026)}`,
      }));
      li.append(nazwa, os, wart);
      return li;
    }));
  }
  for (const btn of document.querySelectorAll('[data-rdr]')) {
    btn.addEventListener('click', () => {
      for (const x of document.querySelectorAll('[data-rdr]')) x.setAttribute('aria-pressed', String(x === btn));
      rysujRoznice(btn.dataset.rdr);
    });
  }

  // ---------- działy: projekt 2027 wobec wybranego roku ----------
  // GUS podaje osobno 18 działów; resztę (m.in. rezerwy w dziale 758) zbieramy w „pozostałe",
  // licząc ją jako różnicę do wydatków ogółem — tak samo dla obu lat.
  const KLUCZ_GUS = (kod) => (kod === '926' ? ['d926b', 'd926'] : [`d${kod}`]);
  const histDzialu = (kod, rok) => {
    for (const k of KLUCZ_GUS(kod)) { const v = D.dzialyHistoria[k]?.[rok]; if (v != null) return v; }
    return null;
  };
  const zHistoria = D.dzialy2027.filter((d) => KLUCZ_GUS(d.kod).some((k) => D.dzialyHistoria[k]));
  const bezHistorii = D.dzialy2027.filter((d) => !zHistoria.includes(d));
  const lataDzialow = Object.keys(D.dzialyHistoria.d_ogolem).map(Number).sort((a, b) => b - a);
  const wyborDz = $('#dz-rok');
  for (const r of lataDzialow) wyborDz.append(new Option(`${r} (wykonanie)`, String(r)));
  let wybranyDzial = null;

  function tabelaDzialow() {
    const rok = wyborDz.value, tryb = $('#dz-tryb').value;
    const ogolemA = D.dzialyHistoria.d_ogolem[rok], ogolemZ = D.prognoza.wydatki['2027'];
    const mnoznik = tryb === 'realne' ? doCen2027(Number(rok)) : 1;
    $('#dz-th-rok').textContent = `Wykonanie ${rok}`;
    const wiersze = zHistoria.map((d) => ({ kod: d.kod, nazwa: `${d.kod} · ${d.nazwa}`, a: histDzialu(d.kod, rok), z: d.kwota }));
    const sumaA = wiersze.reduce((s, w) => s + (w.a ?? 0), 0);
    wiersze.push({
      kod: null, nazwa: `Pozostałe działy, w tym rezerwy (${bezHistorii.map((d) => d.kod).sort().join(', ')})`,
      a: ogolemA - sumaA, z: bezHistorii.reduce((s, d) => s + d.kwota, 0),
    });
    wiersze.sort((x, y) => y.z - x.z);
    wiersze.push({ kod: null, nazwa: 'Wydatki ogółem', a: ogolemA, z: ogolemZ, suma: true });
    const maks = Math.max(...wiersze.filter((w) => !w.suma).map((w) => w.z));
    $('#dz-tbody').replaceChildren(...wiersze.map((w) => {
      const tr = document.createElement('tr');
      if (w.suma) tr.className = 'b27-suma';
      if (w.kod) { tr.dataset.kod = w.kod; tr.tabIndex = 0; tr.setAttribute('aria-selected', String(w.kod === wybranyDzial)); }
      else tr.style.cursor = 'default';
      const nazwa = document.createElement('td');
      nazwa.textContent = w.nazwa;
      if (!w.suma) {
        const pasek = Object.assign(document.createElement('span'), { className: 'b27-dz-pasek' });
        const i = document.createElement('i'); i.style.width = `${(w.z / maks) * 100}%`; pasek.append(i); nazwa.append(pasek);
      }
      let ta, tz, zm, klasa = '';
      if (w.a == null) { ta = 'brak'; tz = tryb === 'udzial' ? fmt.proc((w.z / ogolemZ) * 100) : mln(w.z); zm = '—'; }
      else if (tryb === 'udzial') {
        const ua = (w.a / ogolemA) * 100, uz = (w.z / ogolemZ) * 100;
        ta = fmt.proc(ua); tz = fmt.proc(uz);
        zm = w.suma ? '—' : `${znak(uz - ua)}${fmt.liczba(Math.abs(uz - ua), 1)} pkt proc.`;
        klasa = w.suma ? '' : uz >= ua ? 'b27-plus' : 'b27-minus';
      } else {
        const a = w.a * mnoznik;
        ta = mln(a); tz = mln(w.z); zm = a > 0 ? procZmiany(w.z, a) : '—';
        klasa = w.z >= a ? 'b27-plus' : 'b27-minus';
      }
      const komorki = [ta, tz, zm].map((t, i) => Object.assign(document.createElement('td'), { className: `num${i === 2 && klasa ? ` ${klasa}` : ''}`, textContent: t }));
      tr.append(nazwa, ...komorki);
      return tr;
    }));
    if (wybranyDzial) wykresDzialu(wybranyDzial);
  }
  function wykresDzialu(kod) {
    wybranyDzial = kod;
    const d = D.dzialy2027.find((x) => x.kod === kod);
    const realnie = $('#dz-tryb').value === 'realne', udzial = $('#dz-tryb').value === 'udzial';
    const dane = [...lataDzialow].reverse().map((r) => {
      const v = histDzialu(kod, r);
      if (v == null) return null;
      const w = udzial ? (v / D.dzialyHistoria.d_ogolem[r]) * 100 : realnie ? v * doCen2027(r) : v;
      return [String(r), w, 'k-wykonanie', null];
    }).filter(Boolean);
    const z = udzial ? (d.kwota / D.prognoza.wydatki['2027']) * 100 : d.kwota;
    const format = udzial ? (n) => fmt.proc(n) : fmt.skrot;
    dane.push(['2027', z, 'k-projekt', format(z)]);
    $('#dz-szczegol').hidden = false;
    $('#dz-szczegol-tytul').textContent = `${d.kod} · ${d.nazwa}${udzial ? ' — udział w wydatkach' : realnie ? ' — w cenach z 2027 r.' : ''}`;
    podmien('#dz-wykres', (szer) => slupkowy(dane, { wysokosc: 220, szerokosc: szer, formatY: format }));
    for (const tr of document.querySelectorAll('#dz-tbody tr[data-kod]')) tr.setAttribute('aria-selected', String(tr.dataset.kod === kod));
  }
  $('#dz-tbody').addEventListener('click', (e) => { const tr = e.target.closest('tr[data-kod]'); if (tr) wykresDzialu(tr.dataset.kod); });
  $('#dz-tbody').addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const tr = e.target.closest('tr[data-kod]'); if (tr) { e.preventDefault(); wykresDzialu(tr.dataset.kod); }
  });
  wyborDz.addEventListener('change', tabelaDzialow);
  $('#dz-tryb').addEventListener('change', tabelaDzialow);

  // ---------- dług ----------
  const dlug = [['2026', D.plan2026.dlug, 'k-plan', null]];
  for (const [r, v] of Object.entries(D.prognoza.dlug)) if (Number(r) <= 2040) dlug.push([r, v, r === '2027' ? 'k-projekt' : 'k-prognoza', r === '2027' ? fmt.skrot(v) : null]);
  podmien('#dl-wykres', (szer) => slupkowy(dlug, { wysokosc: 230, szerokosc: szer }));

  // ---------- wyszukiwarka zadań ----------
  const bezOgonkow = (s) => (s || '').toLowerCase()
    .replace(/ą/g, 'a').replace(/ć/g, 'c').replace(/ę/g, 'e').replace(/ł/g, 'l')
    .replace(/ń/g, 'n').replace(/ó/g, 'o').replace(/ś/g, 's').replace(/[żź]/g, 'z');
  const escapuj = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const NA_STRONE = 30;
  let zadania = null, typ = 'P', pokazane = NA_STRONE, wynik = [];

  /**
   * Zapytanie → rdzenie słów. Czytelnik wpisze „Bobrownicka", a w opisie stoi „w ul. Bobrownickiej",
   * więc dłuższym słowom obcinamy końcówkę i szukamy po początku wyrazu. Wszystkie słowa muszą
   * wystąpić. To zgrubne (złapie też wyrazy pokrewne), ale lepiej pokazać za dużo niż nic.
   */
  function rdzenie(zapytanie) {
    return bezOgonkow(zapytanie).split(/[^a-z0-9]+/).filter((w) => w.length > 1)
      .map((w) => (w.length >= 6 ? w.slice(0, -2) : w.length >= 4 ? w.slice(0, -1) : w));
  }
  const pasuje = (plaski, rdz) => rdz.every((r) => plaski.includes(r));
  /** Zaznacza trafienia; pozycje liczymy na tekście bez ogonków (ta sama długość), wycinamy z oryginału. */
  function zaznacz(tekst, rdz) {
    if (!rdz?.length) return escapuj(tekst);
    const plaski = bezOgonkow(tekst);
    const zakresy = [];
    for (const r of rdz) {
      let k = -1;
      while ((k = plaski.indexOf(r, k + 1)) !== -1) {
        if (k > 0 && /[a-z0-9]/.test(plaski[k - 1])) continue;      // tylko początek wyrazu
        let kon = k + r.length;
        while (kon < plaski.length && /[a-z0-9]/.test(plaski[kon])) kon++;
        zakresy.push([k, kon]);
      }
    }
    if (!zakresy.length) return escapuj(tekst);
    zakresy.sort((a, b) => a[0] - b[0]);
    let out = '', i = 0;
    for (const [od, doK] of zakresy) {
      if (od < i) continue;
      out += `${escapuj(tekst.slice(i, od))}<mark>${escapuj(tekst.slice(od, doK))}</mark>`;
      i = doK;
    }
    return out + escapuj(tekst.slice(i));
  }
  function fragment(z, rdz) {
    for (const t of [z.o, ...(z.d ?? []).flatMap((d) => [d.n, d.o])]) {
      if (!t) continue;
      const k = bezOgonkow(t).indexOf(rdz[0]);
      if (k === -1) continue;
      const od = Math.max(0, k - 70), doK = Math.min(t.length, k + rdz[0].length + 100);
      return `${od ? '…' : ''}${zaznacz(t.slice(od, doK).replace(/\s+/g, ' '), rdz)}${doK < t.length ? '…' : ''}`;
    }
    return null;
  }
  function elementZadania(z, fraza) {
    const det = document.createElement('details');
    det.className = 'b27-zadanie';
    const zm = z.r === 'B' && z.a ? `<small>${fmt.liczba(z.a / 1e6, 1)} mln w 2026 · ${procZmiany(z.b, z.a)}</small>` : '';
    const wNazwie = !fraza.length || pasuje(bezOgonkow(`${z.n} ${z.k} ${z.j}`), fraza);
    const traf = fraza.length && !wNazwie ? fragment(z, fraza) : null;
    det.innerHTML = `<summary>
        <span class="b27-z-nazwa">${zaznacz(z.n, fraza)}</span>
        <span class="b27-z-kwota">${mln(z.b, z.b < 1e5 ? 3 : z.b < 1e7 ? 2 : 1)}${zm}</span>
        <span class="b27-z-meta">${escapuj(z.k)} · ${zaznacz(z.j, fraza)}</span>
        ${traf ? `<span class="b27-z-trafienie">${traf}</span>` : ''}
      </summary>`;
    // treść budujemy dopiero przy rozwinięciu — przy kilkuset zadaniach to realna różnica
    det.addEventListener('toggle', () => {
      if (!det.open || det.querySelector('.b27-z-tresc')) return;
      const tresc = document.createElement('div');
      tresc.className = 'b27-z-tresc';
      const czesci = z.d?.length ? z.d : [{ n: '', b: z.b, a: z.a, o: z.o }];
      tresc.innerHTML = czesci.map((d) => `<div class="b27-etap">
          <strong>${zaznacz(d.n || z.n, fraza)}</strong>
          <span class="kw">${d.b != null ? fmt.zl(d.b) : '—'}${z.r === 'B' && d.a != null ? ` <span class="drobne">(2026: ${fmt.zl(d.a)})</span>` : ''}</span>
          ${d.o ? `<p>${zaznacz(d.o, fraza)}</p>` : ''}
        </div>`).join('')
        + `<p class="b27-z-zrodlo">Źródło: Materiały informacyjne do projektu budżetu na 2027 r., cz. 1, strona ${z.s} pliku PDF.</p>`;
      det.append(tresc);
    });
    return det;
  }
  function filtruj() {
    if (!zadania) return;
    const fraza = rdzenie($('#z-fraza').value);
    const jednostka = $('#z-jednostka').value;
    let sort = $('#z-sort').value;
    if (typ === 'P' && (sort === 'wzrost' || sort === 'spadek')) sort = 'kwota';
    wynik = zadania.filter((z) => z.r === typ && (!jednostka || z.j === jednostka) && (!fraza.length || pasuje(z._s, fraza)));
    const klucz = { kwota: (a, b) => b.b - a.b, nazwa: (a, b) => a.n.localeCompare(b.n, 'pl'),
      wzrost: (a, b) => (b.b - (b.a ?? 0)) - (a.b - (a.a ?? 0)), spadek: (a, b) => (a.b - (a.a ?? 0)) - (b.b - (b.a ?? 0)) }[sort];
    wynik.sort(klucz);
    pokazane = NA_STRONE;
    rysujZadania(fraza);
    const p = new URLSearchParams(location.search);
    for (const [k, v] of [['q', $('#z-fraza').value.trim()], ['typ', typ === 'P' ? '' : typ], ['jednostka', jednostka]]) v ? p.set(k, v) : p.delete(k);
    history.replaceState(null, '', `${p.toString() ? `?${p}` : location.pathname}${location.hash}`);
  }
  function rysujZadania(fraza = rdzenie($('#z-fraza').value)) {
    $('#z-lista').replaceChildren(...wynik.slice(0, pokazane).map((z) => elementZadania(z, fraza)));
    const suma = wynik.reduce((s, z) => s + z.b, 0);
    $('#z-licznik').textContent = wynik.length
      ? `Znaleziono ${fmt.liczba(wynik.length)} ${fmt.odmien(wynik.length, ['zadanie', 'zadania', 'zadań'])} na łączną kwotę ${fmt.kwota(suma)} w 2027 r.`
        + (fraza.length ? ' Kwota dotyczy całych zadań, a nie tylko fragmentu z szukanym słowem.' : '')
      : 'Brak zadań dla tych kryteriów. Spróbuj krótszej frazy albo drugiej zakładki.';
    const zostalo = wynik.length - pokazane;
    $('#z-wiecej').hidden = zostalo <= 0;
    $('#z-wiecej').textContent = `Pokaż kolejne ${Math.min(NA_STRONE, zostalo)} (z ${fmt.liczba(Math.max(zostalo, 0))} pozostałych)`;
  }
  function slownikJednostek() {
    const sel = $('#z-jednostka'), biezaca = sel.value;
    const nazwy = [...new Set(zadania.filter((z) => z.r === typ).map((z) => z.j))].sort((a, b) => a.localeCompare(b, 'pl'));
    sel.replaceChildren(new Option('wszystkie', ''));
    for (const n of nazwy) sel.append(new Option(n.length > 58 ? `${n.slice(0, 57)}…` : n, n));
    if (nazwy.includes(biezaca)) sel.value = biezaca;
    for (const o of $('#z-sort').options) o.hidden = o.dataset.tylko === 'B' && typ !== 'B';
    if ($('#z-sort').selectedOptions[0]?.hidden) $('#z-sort').value = 'kwota';
  }
  async function wczytajZadania() {
    if (zadania) return;
    try {
      const d = await (await fetch('/dane/budzet2027/zadania.json')).json();
      for (const z of d.zadania) z._s = bezOgonkow([z.k, z.n, z.j, z.o, ...(z.d ?? []).flatMap((x) => [x.n, x.o])].filter(Boolean).join(' '));
      zadania = d.zadania;
      slownikJednostek();
      const j = new URLSearchParams(location.search).get('jednostka');
      if (j) $('#z-jednostka').value = j;
      filtruj();
    } catch {
      $('#z-licznik').textContent = 'Nie udało się wczytać listy zadań. Odśwież stronę.';
    }
  }
  for (const btn of document.querySelectorAll('[data-typ]')) {
    btn.addEventListener('click', () => {
      typ = btn.dataset.typ;
      for (const x of document.querySelectorAll('[data-typ]')) x.setAttribute('aria-pressed', String(x === btn));
      if (zadania) { slownikJednostek(); filtruj(); }
    });
  }
  let timer;
  $('#z-fraza').addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(filtruj, 160); });
  $('#z-jednostka').addEventListener('change', filtruj);
  $('#z-sort').addEventListener('change', filtruj);
  $('#z-wiecej').addEventListener('click', () => { pokazane += NA_STRONE; rysujZadania(); });

  // stan z adresu: link do konkretnego wyszukiwania ma działać od razu
  const adres = new URLSearchParams(location.search);
  if (adres.get('q')) $('#z-fraza').value = adres.get('q');
  if (adres.get('typ') === 'B') {
    typ = 'B';
    for (const x of document.querySelectorAll('[data-typ]')) x.setAttribute('aria-pressed', String(x.dataset.typ === 'B'));
  }
  // lista zadań jest duża — doczytujemy ją, gdy czytelnik zbliża się do wyszukiwarki albo przyszedł z linkiem
  if (adres.get('q') || adres.get('jednostka') || location.hash === '#zadania') wczytajZadania();
  else if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((wpisy) => { if (wpisy.some((w) => w.isIntersecting)) { io.disconnect(); wczytajZadania(); } }, { rootMargin: '600px' });
    io.observe($('#zadania'));
  } else wczytajZadania();

  // ---------- start ----------
  wyborRoku.value = String(lataWykonania[0]);
  wyborDz.value = String(lataDzialow[0]);
  rysujOs();
  tabelaRoku();
  tabelaDzialow();
  // Wykresy i tabele powstają dopiero tutaj i przesuwają treść w dół, więc wejście z kotwicą
  // (#dlug, #zadania…) lądowało za wysoko. Po narysowaniu wracamy we właściwe miejsce.
  if (location.hash.length > 1) {
    try { document.querySelector(location.hash)?.scrollIntoView(); } catch { /* kotwica spoza strony */ }
  }
</script>
