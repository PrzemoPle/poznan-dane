  .b27-zadanie > summary { list-style: none; cursor: pointer; padding: 12px 14px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; align-items: baseline; }
  .b27-zadanie > summary::-webkit-details-marker { display: none; }
  .b27-zadanie > summary:hover { background: var(--akcent-tlo); }
  .b27-zadanie[open] > summary { border-bottom: 1px solid var(--linia); }
  .b27-z-nazwa { font-weight: 600; line-height: 1.35; text-wrap: pretty; }
  .b27-z-kwota { font-family: var(--mono); font-weight: 600; white-space: nowrap; text-align: right; }
  .b27-z-kwota small { display: block; font-weight: 400; font-size: .74rem; color: var(--tekst-3); }
  .b27-z-meta { grid-column: 1 / -1; font-size: .8rem; color: var(--tekst-3); }
  .b27-z-trafienie { grid-column: 1 / -1; font-size: .84rem; color: var(--tekst-2); }
  .b27-z-trafienie mark, .b27-z-tresc mark { background: var(--czerwien-tlo); color: inherit; border-radius: 2px; padding: 0 2px; }
  .b27-z-tresc { padding: 12px 14px 14px; display: grid; gap: 12px; }
